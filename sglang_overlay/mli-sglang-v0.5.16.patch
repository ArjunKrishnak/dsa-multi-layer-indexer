+Replaces the eager chain (KV gather -> einsum -> relu -> head-sum) on every
+index-reusing layer with ONE kernel launch: for each (row, pool-slot) it
+gathers the producer layer's latent-KV row, computes per-head logits against
+the producer's absorbed q, and accumulates the ReLU'd head-sum tap score.
+The eager chain was ~10-15 launches/layer x 45 shared layers and dominated
+the unfused cascade's -39% decode tax (launch/latency bound, not FLOPs).
+
+Decode-only, small B: grid = (B, ceil(P / BLOCK_P)).
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _tap_score_kernel(
+    q_ptr,  # (B, H, D) bf16 — producer layer's absorbed q (nope||rope)
+    kv_ptr,  # (S, D) bf16 — producer layer's latent KV cache
+    pool_ptr,  # (B, P) int32 — candidate KV slots, -1 = invalid
+    w_ptr,  # (H,) fp32 — per-head tap weights (uniform = ones)
+    out_ptr,  # (B, P) fp32 — tap scores (-inf where invalid)
+    sm_scale,
+    S_kv,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    P,
+    BLOCK_P: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    b = tl.program_id(0)
+    pb = tl.program_id(1)
+    p_off = pb * BLOCK_P + tl.arange(0, BLOCK_P)
+    p_mask = p_off < P
+
+    slots = tl.load(pool_ptr + b * P + p_off, mask=p_mask, other=-1)
+    # Bound against the pool: stale CUDA-graph rows can carry garbage slots;
+    # an OOB gather here is the same illegal-access class as jobs 22921/35.
+    valid = (slots >= 0) & (slots < S_kv)
+    safe_slots = tl.where(valid, slots, 0)
+
+    # Accumulate per-head logits over D in chunks, then relu+sum over heads.
+    acc = tl.zeros((H, BLOCK_P), dtype=tl.float32)
+    for d0 in range(0, D, BLOCK_D):
+        d_off = d0 + tl.arange(0, BLOCK_D)
+        # q tile: (H, BLOCK_D)
+        q_tile = tl.load(
+            q_ptr + b * H * D + tl.arange(0, H)[:, None] * D + d_off[None, :]
+        ).to(tl.float32)
+        # kv tile: (BLOCK_P, BLOCK_D) gathered by slot
+        kv_tile = tl.load(
+            kv_ptr + safe_slots[:, None] * D + d_off[None, :],
+            mask=p_mask[:, None],
+            other=0.0,
+        ).to(tl.float32)
+        acc += tl.dot(q_tile, kv_tile.trans())
+
+    w = tl.load(w_ptr + tl.arange(0, H))
+    tap = tl.sum(tl.maximum(acc * sm_scale, 0.0) * w[:, None], axis=0)
+    tap = tl.where(valid & p_mask, tap, float("-inf"))
+    tl.store(out_ptr + b * P + p_off, tap, mask=p_mask)
+
+
+@triton.jit
+def _tap_rerank_kernel(
+    q_ptr,  # (B, H, D) bf16 — producer layer's absorbed q
+    kv_ptr,  # (S, D) bf16 — producer layer's latent KV cache
+    inc_ptr,  # (B, K) int32 — incumbent (copied) index values, -1 padded
+    adm_ptr,  # (B, A) int32 — admitted index values, -1 = invalid
+    adm_kv_ptr,  # (B, A) int32 — admitted KV slots for scoring (== adm in slot space)
+    inc_kv_ptr,  # (B, K) int32 — incumbent KV slots for scoring
+    out_ptr,  # (B, K) int32 — re-ranked index values, -1 suffix-padded
+    sm_scale,
+    S_kv,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    K: tl.constexpr,  # incumbent width / output width (index_topk)
+    A: tl.constexpr,  # admitted width
+    P2: tl.constexpr,  # pow2 >= K + A (sort width)
+    BLOCK_D: tl.constexpr,
+):
+    """E4c: one launch per (layer, row) doing dedup + score + select + compact.
+
+    Replaces the eager chain (dup-mask, cat, score kernel, all-reduce-less
+    masked_fill, topk, two gathers) whose ~8 launches x 45 shared layers
+    dominated the remaining cascade decode tax. Selection = in-SRAM
+    descending sort over the padded pool; compaction falls out of the sort
+    (invalid entries carry -inf and land at the tail).
+    """
+    b = tl.program_id(0)
+
+    p_off = tl.arange(0, P2)
+    is_inc = p_off < K
+    is_adm = (p_off >= K) & (p_off < K + A)
+    in_pool = p_off < K + A
+
+    # Index values (output space) and KV slots (scoring space) for the pool.
+    idx_vals = tl.where(
+        is_inc,
+        tl.load(inc_ptr + b * K + tl.minimum(p_off, K - 1)),
+        tl.load(adm_ptr + b * A + tl.minimum(tl.maximum(p_off - K, 0), A - 1)),
+    )
+    idx_vals = tl.where(in_pool, idx_vals, -1)
+    kv_slots = tl.where(
+        is_inc,
+        tl.load(inc_kv_ptr + b * K + tl.minimum(p_off, K - 1)),
+        tl.load(
+            adm_kv_ptr + b * A + tl.minimum(tl.maximum(p_off - K, 0), A - 1)
+        ),
+    )
+
+    # Dedup admitted vs incumbent: an admitted value equal to ANY incumbent
+    # value is invalidated (the sparse kernel double-counts duplicates).
+    dup = tl.zeros((P2,), dtype=tl.int1)
+    for k0 in range(0, K, 256):
+        inc_tile = tl.load(
+            inc_ptr + b * K + k0 + tl.arange(0, 256),
+            mask=(k0 + tl.arange(0, 256)) < K,
+            other=-2,
+        )
+        hit = (
+            tl.max((idx_vals[:, None] == inc_tile[None, :]).to(tl.int32), axis=1)
+            > 0
+        )
+        dup = dup | (hit & is_adm)
+
+    valid = in_pool & (idx_vals >= 0) & ~dup & (kv_slots >= 0) & (kv_slots < S_kv)
+    safe_slots = tl.where(valid, kv_slots, 0)
+
+    # Tap scores: sum_h relu(sm_scale * q_h . kv_slot).
+    acc = tl.zeros((H, P2), dtype=tl.float32)
+    for d0 in range(0, D, BLOCK_D):
+        d_off = d0 + tl.arange(0, BLOCK_D)
+        q_tile = tl.load(
+            q_ptr + b * H * D + tl.arange(0, H)[:, None] * D + d_off[None, :]
+        ).to(tl.float32)
+        kv_tile = tl.load(
+            kv_ptr + safe_slots[:, None] * D + d_off[None, :],
+            mask=in_pool[:, None],
+            other=0.0,
+        ).to(tl.float32)
+        acc += tl.dot(q_tile, kv_tile.trans())
+    tap = tl.sum(tl.maximum(acc * sm_scale, 0.0), axis=0)
+    tap = tl.where(valid, tap, float("-inf"))
+
+    # Key-value sort via int64 packing: fp32 score -> order-preserving uint32
+    # (sign-flip trick), packed above 21 bits of (index+1). Descending sort of
+    # keys sorts by score with index tie-break; invalid (-inf) entries carry
+    # key 0 and sink to the tail, so the first K outputs are the selected
+    # set, already compacted with -1 suffix padding.
+    score_bits = tap.to(tl.int32, bitcast=True)
+    ordered = tl.where(
+        score_bits < 0, ~score_bits, score_bits | -2147483648
+    ).to(tl.int64) & 0xFFFFFFFF
+    key = tl.where(
+        valid,
+        (ordered << 21) | (idx_vals.to(tl.int64) + 1),
+        tl.zeros((P2,), dtype=tl.int64),
+    )
+    key_sorted = tl.sort(key, descending=True)
+    out_off = tl.arange(0, P2)
+    out_vals = tl.where(
+        key_sorted > 0, (key_sorted & ((1 << 21) - 1)) - 1, -1
+    ).to(tl.int32)
+    tl.store(out_ptr + b * K + out_off, out_vals, mask=out_off < K)
+
+
+@triton.jit
+def _pack_sort_select_kernel(
+    tap_ptr,  # (B, P) fp32 scores (-inf invalid)
+    idx_ptr,  # (B, P) int32 native index values
+    out_ptr,  # (B, K) int32 selected, -1 suffix-padded
+    P,
+    K,
+    P2: tl.constexpr,
+):
+    """Selection half of E4c: pack (score, index) into int64, in-SRAM sort
+    descending, emit top-K compacted (invalid keys are 0 and sink to tail).
+    One CTA per row; P2 int64 keys = 32KB SRAM at P2=4096."""
+    b = tl.program_id(0)
+    p_off = tl.arange(0, P2)
+    in_p = p_off < P
+    tap = tl.load(tap_ptr + b * P + p_off, mask=in_p, other=float("-inf"))
+    idx = tl.load(idx_ptr + b * P + p_off, mask=in_p, other=-1)
+    valid = in_p & (idx >= 0) & (tap > float("-inf"))
+    score_bits = tap.to(tl.int32, bitcast=True)
+    ordered = tl.where(
+        score_bits < 0, ~score_bits, score_bits | -2147483648
+    ).to(tl.int64) & 0xFFFFFFFF
+    key = tl.where(
+        valid,
+        (ordered << 21) | (idx.to(tl.int64) + 1),
+        tl.zeros((P2,), dtype=tl.int64),
+    )
+    key_sorted = tl.sort(key, descending=True)
+    out_vals = tl.where(
+        key_sorted > 0, (key_sorted & ((1 << 21) - 1)) - 1, -1
+    ).to(tl.int32)
+    tl.store(out_ptr + b * K + p_off, out_vals, mask=p_off < K)
+
+
+def tap_rerank_fused(
+    q_all: torch.Tensor,  # (B, H, D)
+    kv_cache: torch.Tensor,
+    incumbent: torch.Tensor,  # (B, K) int32, native index space
+    admitted: torch.Tensor,  # (B, A) int32, native index space
+    incumbent_kv: torch.Tensor,  # (B, K) int32, KV-slot space
+    admitted_kv: torch.Tensor,  # (B, A) int32, KV-slot space
+    sm_scale: float,
+    head_weights: torch.Tensor = None,
+) -> torch.Tensor:
+    """E4c (chunk-scored variant): the monolithic kernel's (H, P2) fp32
+    accumulator blew SRAM (job 22985). Two launches per layer instead: the
+    tiled score kernel writes a scratch score row, then a single-CTA
+    pack-sort-select kernel emits the compacted top-K. Dedup is handled by
+    scoring: an admitted duplicate ties its incumbent twin and the packed
+    index tie-break keeps them adjacent — the duplicate REMAINS possible, so
+    callers must pre-mask duplicates in `admitted` (-1)."""
+    bsz, num_heads, head_dim = q_all.shape
+    kv_flat = kv_cache.view(kv_cache.shape[0], -1)
+    K = incumbent.shape[1]
+    A = admitted.shape[1]
+    pool = torch.cat([incumbent, admitted], dim=1).to(torch.int32).contiguous()
+    pool_kv = (
+        torch.cat([incumbent_kv, admitted_kv], dim=1).to(torch.int32).contiguous()
+    )
+    P = K + A
+    tap = tap_scores_fused(
+        q_all, kv_cache, pool_kv, sm_scale, head_weights=head_weights
+    )
+    out = torch.empty((bsz, K), device=q_all.device, dtype=torch.int32)
+    _pack_sort_select_kernel[(bsz,)](
+        tap,
+        pool,
+        out,
+        P,
+        K,
+        P2=triton.next_power_of_2(P),
+        num_warps=8,
+    )
+    return out
+
+
+def tap_scores_fused(
+    q_all: torch.Tensor,  # (B, H, D) bf16
+    kv_cache: torch.Tensor,  # (S, 1, D) or (S, D)
+    pool: torch.Tensor,  # (B, P) int32/int64, -1 padded
+    sm_scale: float,
+    head_weights: torch.Tensor = None,  # (H,) fp32 distilled tap weights
+) -> torch.Tensor:
+    bsz, num_heads, head_dim = q_all.shape
+    kv_flat = kv_cache.view(kv_cache.shape[0], -1)
+    assert kv_flat.shape[-1] == head_dim, (kv_flat.shape, head_dim)
+    pool_i32 = pool.to(torch.int32).contiguous()
+    P = pool_i32.shape[1]
+    out = torch.empty((bsz, P), device=q_all.device, dtype=torch.float32)
+    BLOCK_P = 64
+    BLOCK_D = 64
+    grid = (bsz, triton.cdiv(P, BLOCK_P))
+    if head_weights is None:
+        head_weights = torch.ones(
+            num_heads, device=q_all.device, dtype=torch.float32
+        )
+    _tap_score_kernel[grid](
+        q_all.contiguous(),
+        kv_flat,
+        pool_i32,
+        head_weights.contiguous(),
+        out,
+        sm_scale,
+        kv_flat.shape[0],
+        H=num_heads,
+        D=head_dim,
+        P=P,
+        BLOCK_P=BLOCK_P,
+        BLOCK_D=BLOCK_D,
+        num_warps=4,
+    )
+    return out
