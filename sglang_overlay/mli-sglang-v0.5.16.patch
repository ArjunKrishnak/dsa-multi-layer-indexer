+            self._transform_reuse_indices(attend_src, forward_batch),
+        )
+
+    def _hide_topk_to_slots(self, metadata, topk):
+        """Map an indexer top-k (native position OR already-slot space) to KV
+        slots, for threading the lag incumbent through the registry."""
+        if self._hh_topk_is_slot_space():
+            return topk.to(torch.int64)
+        slots = self._hh_slots_for_positions(metadata, topk.clamp(min=0).long())
+        if slots is None:
+            return topk.to(torch.int64)
+        return slots.masked_fill(topk.long() < 0, -1)
+
+    def _maybe_hide_lag_indexer(
+        self, hidden_states, q_lora, positions, forward_batch, prev_topk_indices
+    ):
+        """Paper's one-layer cross-layer lag producer (decode, b=1).
+
+        Returns this layer's ATTENTION index set (= 𝒮^(ℓ-1), the incumbent) and
+        stashes ``forward_batch._hh_hide_layers[layer_id]`` so dsa_backend runs
+        the fused launch (attention over the incumbent + this layer's REAL fp8
+        indexer over the full prefix -> 𝒮^(ℓ), threaded to ℓ+1 via the registry).
+        Returns None to fall back to the stock serial indexer.
+
+        Bootstrap: the first lag layer (no predecessor set in the registry) runs
+        the stock indexer serially and seeds the registry with its top-k (this
+        makes attention(ℓ) and indexer(ℓ) independent for every later layer).
+        """
+        if not self._hide_lag_active(prev_topk_indices, forward_batch):
+            return None
+        metadata = get_attn_backend().get_indexer_metadata(
+            self.layer_id, forward_batch
+        )
+        if metadata is None:
+            return None
+        from sglang.srt.layers.attention.dsa_backend import (
+            hh_get_fused_next_idx,
+            hh_set_fused_next_idx,
+        )
+
+        # Incumbent = the fresh set produced by the PREVIOUS HIDE layer of THIS
+        # forward. Under index reuse that is the previous REFRESH layer, not
+        # layer_id-1 (whose skip copy never writes the registry). Python-level
+        # bookkeeping on the batch: under CUDA-graph capture it fixes the graph's
+        # structure once (the first HIDE layer bootstraps, every later one reads
+        # the registry buffer the fused kernel rewrites on each replay).
+        prev_hide = getattr(forward_batch, "_hh_hide_prev_layer", None)
+        inc_slots = hh_get_fused_next_idx(prev_hide) if prev_hide is not None else None
+        if inc_slots is None:
+            # BOOTSTRAP: run the stock indexer; seed the registry (slot space).
+            topk = self.indexer(
+                x=hidden_states,
+                q_lora=q_lora,
+                positions=positions,
+                forward_batch=forward_batch,
+                layer_id=self.layer_id,
+            )
+            if topk is None:
+                return None
+            hh_set_fused_next_idx(
+                self.layer_id, self._hide_topk_to_slots(metadata, topk)
+            )
+            forward_batch._hh_hide_prev_layer = self.layer_id
+            return topk
+
+        # LAG: expose this layer's real indexer operands (prepare+store, NO
+        # top-k) + the PAGED index-K cache; the fused kernel does the rest.
+        # Under the side-stream select (HH_HIDE_SELECT=prod_side) the prep
+        # itself runs on the dedicated side stream too, overlapping this layer's
+        # own q/kv projections; the backend joins it right before the fused
+        # launch (the launch is the first consumer of these operands).
+        from sglang.srt.layers.attention.dsa.hh_fused_decode import _HIDE_SELECT as _hh_sel_mode
+        _side_prep = _hh_sel_mode == "prod_side"
+        if _side_prep:
+            from sglang.srt.layers.attention.dsa_backend import hh_lag_idx_stream
+            _idx_stream = hh_lag_idx_stream()
+            _cur_stream = torch.cuda.current_stream()
+            _idx_stream.wait_stream(_cur_stream)
+            with torch.cuda.stream(_idx_stream):
+                ops = self.indexer.forward_hide_operands(
+                    hidden_states, q_lora, positions, forward_batch, self.layer_id,
+                    metadata=metadata,
+                )
+            if ops is None:
+                _cur_stream.wait_stream(_idx_stream)   # never leave a dangling fork
+            else:
+                forward_batch._hh_hide_prep_pending = True
+        else:
+            ops = self.indexer.forward_hide_operands(
+                hidden_states, q_lora, positions, forward_batch, self.layer_id,
+                metadata=metadata,
+            )
+        if ops is None:
+            # operand path unavailable -> stock indexer, but keep the lag threaded
+            topk = self.indexer(
+                x=hidden_states,
+                q_lora=q_lora,
+                positions=positions,
+                forward_batch=forward_batch,
+                layer_id=self.layer_id,
+            )
+            if topk is not None:
+                hh_set_fused_next_idx(
+                    self.layer_id, self._hide_topk_to_slots(metadata, topk)
+                )
+            return topk
+
+        q_fp8, weights, index_k_paged, page_table_64, seq_lens, skv_cap = ops
+        device = q_fp8.device
+        budget = self.indexer.index_topk
+        incumbent_slots = inc_slots[:, :budget]
+        if incumbent_slots.shape[0] != q_fp8.shape[0]:
+            # Fail LOUD (anti-false-claim): a silent fallback would report the
+            # serial lag as HIDE.
+            raise RuntimeError(
+                "[HIDE VOID] incumbent batch %d != decode batch %d "
+                "(registry/graph batch desync)"
+                % (incumbent_slots.shape[0], q_fp8.shape[0])
+            )
+        # int32 slots straight from the registry (the fused kernel consumes
+        # them directly); only the bootstrap layer's int64 seed pays a cast.
+        if incumbent_slots.dtype != torch.int32:
+            incumbent_slots = incumbent_slots.to(torch.int32)
+        incumbent_slots = incumbent_slots.contiguous()
+
+        # out_index_pool[b, pos] = KV slot of prefix position pos, so next_idx
+        # returns in SLOT space (the next HIDE layer's incumbent directly).
+        # Static width skv_cap, computed once per forward (cached on the batch):
+        # the page_size=1 table when the backend still holds one, else the
+        # page-64 decomposition (the decode graph always keeps the page-64 table).
+        out_index_pool = getattr(forward_batch, "_hh_hide_out_pool", None)
+        from sglang.srt.layers.attention.dsa.hh_fused_decode import _HIDE_SELECT as _hh_sel
+        if _hh_sel in ("exact", "approx", "prod", "prod_side"):
+            # the kernel / production top-k emit slots through the page-64
+            # table themselves: no position->slot map is needed
+            out_index_pool = None
+        elif out_index_pool is None or out_index_pool.shape[1] != skv_cap:
+            page_table_1 = metadata.get_page_table_1()
+            if page_table_1 is not None and page_table_1.shape[1] >= skv_cap:
+                out_index_pool = page_table_1[:, :skv_cap]
+            else:
+                in_page = torch.arange(64, device=device, dtype=torch.int64)
+                out_index_pool = (
+                    page_table_64.to(torch.int64)[:, :, None] * 64 + in_page
+                ).reshape(page_table_64.shape[0], -1)[:, :skv_cap]
+            forward_batch._hh_hide_out_pool = out_index_pool
+
+        hide_ctx = getattr(forward_batch, "_hh_hide_layers", None)
+        if hide_ctx is None:
+            hide_ctx = {}
+            forward_batch._hh_hide_layers = hide_ctx
+        # Env-gated in-server set check (HH_HIDE_SETCHECK=1, eager runs): the
+        # backend calls this closure after the fused launch to recompute this
+        # layer's selection with the STOCK indexer on the same operands and
+        # compare sets -- the "bit-identical selection" claim, checked in situ.
+        # The extra K-cache store it performs writes the same bytes (idempotent).
+        check_fn = None
+        if _hh_os_fm.environ.get("HH_HIDE_SETCHECK") == "1":
+            def check_fn(_hs=hidden_states, _ql=q_lora, _pos=positions, _fb=forward_batch, _md=metadata):
+                ref = self.indexer(x=_hs, q_lora=_ql, positions=_pos, forward_batch=_fb, layer_id=self.layer_id)
+                return None if ref is None else self._hide_topk_to_slots(_md, ref)
+        hide_ctx[self.layer_id] = (
+            incumbent_slots,
+            q_fp8,
+            weights,
+            index_k_paged,
+            page_table_64,
+            seq_lens,
+            skv_cap,
+            out_index_pool,
+            forward_batch,
+            check_fn,
+            metadata,
+        )
+        forward_batch._hh_hide_prev_layer = self.layer_id
+        # This layer attends over the incumbent; return it as topk_indices (the
+        # fused path consumes the ctx; this is the capture/fallback value).
+        return incumbent_slots
+
+    @staticmethod
+    def _hh_topk_is_slot_space() -> bool:
+        """Whether topk_indices carry KV SLOTS or TOKEN POSITIONS.
+
+        The indexer's topk_transform output space depends on the backend
+        path: with fused topk (one_batch / fused decode graph) the values are
+        page_size=1 KV slots consumed directly; on the non-fused path they
+        are token positions that the backend maps through the page table per
+        layer (transform_index_page_table_decode). Unioning SLOT values into
+        a POSITION-space tensor sent that transform gathering page_table at
+        ~500K slot ids against a ~164K-wide table — the whole server-mode
+        illegal-access chain (22921/35/49/64/67). In position space the
+        window/sink admission needs NO page-table mapping at all.
+        """
+        return bool(getattr(get_attn_backend(), "use_fused_topk", False))
+
+    @staticmethod
+    def _hh_slots_for_positions(metadata, pos: torch.Tensor) -> Optional[torch.Tensor]:
+        """Map token positions -> page_size=1 KV slots via whichever page
+        table the backend still materializes.
+
+        The fused-topk decode CUDA graph drops the page_size=1 table
+        (dsa_drop_wide_page_table), so get_page_table_1() can be None there;
+        the page-64 table is always kept and slots decompose as
+        table64[row, p // 64] * 64 + p % 64 (see dsa_topk_backend docs).
+        Returns None if neither table is available (caller falls back to copy).
+        """
+        page_table_1 = metadata.get_page_table_1()
+        if page_table_1 is not None:
+            pos = pos.clamp(max=page_table_1.shape[1] - 1)
+            slots = torch.gather(page_table_1, 1, pos.long())
+        else:
+            page_table_64 = metadata.get_page_table_64()
+            if page_table_64 is None:
+                return None
+            pos = pos.clamp(max=page_table_64.shape[1] * 64 - 1)
+            blocks = torch.gather(page_table_64, 1, (pos // 64).long())
+            slots = blocks * 64 + (pos % 64)
+        # Unallocated page-table blocks hold -1; the block decomposition turns
+        # those into arbitrary negatives (-1*64+p), and stale CUDA-graph rows
+        # can hold garbage large values. The sparse kernels only tolerate
+        # exactly -1 (or >= s_kv on some impls) — anything else is an illegal
+        # memory access (server crashes 22921/22/35). Force every slot outside
+        # [0, kv_pool_size) to exactly -1.
+        kv_pool_size = get_token_to_kv_pool().get_key_buffer(0).shape[0]
+        return slots.masked_fill((slots < 0) | (slots >= kv_pool_size), -1)
+
+    def _admit_reuse_indices(
+        self: DeepseekV2AttentionMLA,
+        prev_topk_indices: Optional[torch.Tensor],
+        forward_batch: ForwardBatch,
+    ) -> Optional[torch.Tensor]:
+        """Admission on reused (skip_topk) layers: splice recency-window and
+        sink KV slots into the copied index set at iso-budget (decode only).
+
+        Copied indices go stale for decode tokens: the producer's set cannot
+        contain slots the copy has no path to re-admit (our set-space lever).
+        Config knobs (via --json-model-override-args): index_reuse_window (W,
+        0=off) and index_reuse_nsink. The copied set's tail is evicted to make
+        room; topk_transform output order is unspecified, so tail-eviction ~
+        random eviction of the copied set (pessimistic for us, acceptable).
+        Indices here are page_size=1 KV slots (post topk_transform), so window
+        positions are mapped through the same page table the indexer uses.
+        Duplicate slots would be double-counted by sparse attention, so newly
+        admitted slots are masked to -1 where already present in the kept set.
+        """
+        window = getattr(self, "_index_reuse_window", 0)
+        nsink = getattr(self, "_index_reuse_nsink", 0)
+        if (
+            prev_topk_indices is None
+            or (window <= 0 and nsink <= 0)
+            or not forward_batch.forward_mode.is_decode_or_idle()
+        ):
+            return prev_topk_indices
+
+        metadata = get_attn_backend().get_indexer_metadata(
+            self.layer_id, forward_batch
+        )
+        if metadata is None:
+            return prev_topk_indices
+
+        seqlens = metadata.get_seqlens_int32()  # (B,) int32
+        bsz, budget = prev_topk_indices.shape
+        n_admit = min(window + nsink, budget)
+        device = prev_topk_indices.device
+
+        # Admission positions per row: sinks [0, nsink) plus the recency
+        # window [seqlen - window, seqlen). Clamp handles seqlen < window;
+        # the duplicate mask below drops the resulting repeats.
+        offsets = torch.arange(n_admit, device=device, dtype=torch.int32)
+        pos = torch.where(
+            offsets < nsink,
+            offsets.unsqueeze(0).expand(bsz, -1),
+            seqlens.unsqueeze(1) - (window + nsink) + offsets.unsqueeze(0),
+        ).clamp_(min=0)
+        if self._hh_topk_is_slot_space():
+            raw_slots = self._hh_slots_for_positions(metadata, pos)
+            if raw_slots is None:
+                return prev_topk_indices
+            admit_slots = raw_slots.to(prev_topk_indices.dtype)
+        else:
+            # Position space: window/sink positions ARE the index values.
+            admit_slots = pos.to(prev_topk_indices.dtype)
+        # CUDA-graph padded rows carry garbage seqlens/page-table content; a
+        # position outside the row's real sequence maps to a garbage slot.
+        # Mask those to -1 (kernel padding) instead of letting them reach the
+        # attention kernel (illegal-memory-access crash, jobs 22921/22922).
+        valid_pos = (pos < seqlens.unsqueeze(1)) & (seqlens.unsqueeze(1) > 0)
+        admit_slots = admit_slots.masked_fill(~valid_pos, -1)
+
+        # Iso-budget: keep the first (budget - n_admit) copied slots, splice
+        # admitted slots into the tail. Mask admitted slots already present in
+        # the kept prefix to -1 (padding) to avoid double-counted KV slots.
+        kept = prev_topk_indices[:, : budget - n_admit]
+        dup = (admit_slots.unsqueeze(2) == kept.unsqueeze(1)).any(dim=2)
+        admit_slots = admit_slots.masked_fill(dup, -1)
+        out = torch.cat([kept, admit_slots], dim=1)
+        # The fused decode path tolerates -1 only as SUFFIX padding (cascade's
+        # score-sorted output survives; this cat leaves -1 holes mid-row and
+        # crashed server decode 22921/35/49). Slot order is irrelevant to
+        # attention, so sort descending to push every -1 to the tail.
+        return torch.sort(out, dim=1, descending=True).values
+
+    def _transform_reuse_indices(
+        self: DeepseekV2AttentionMLA,
+        prev_topk_indices: Optional[torch.Tensor],
+        forward_batch: ForwardBatch,
+    ) -> Optional[torch.Tensor]:
+        """Reuse-op dispatch on skip_topk layers: cascade (tap re-rank +
+        admission) > admission-only > verbatim copy (stock IndexCache)."""
+        # admit_every freeze: this layer passes through incumbent unchanged.
+        if getattr(self, "_index_admit_freeze", False):
+            return prev_topk_indices
+        if getattr(self, "_index_reuse_rerank", False):
+            # E4d fused cascade: stash a per-layer context so THIS layer's
+            # forward_decode runs attention + next-index in one fused launch;
+            # returns this layer's incumbent. None -> fall back to triton cascade.
+            if (
+                getattr(self, "_index_reuse_rerank_impl", "triton") in ("fused", "tap")
+                and forward_batch.forward_mode.is_decode_or_idle()
+            ):
+                fused_inc = self._fused_reuse_transform(
+                    prev_topk_indices, forward_batch
+                )
+                if fused_inc is not None:
+                    return fused_inc
+            return self._cascade_rerank_indices(prev_topk_indices, forward_batch)
+        return self._admit_reuse_indices(prev_topk_indices, forward_batch)
+
+    def _fused_reuse_transform(
+        self: DeepseekV2AttentionMLA,
+        prev_topk_indices: Optional[torch.Tensor],
+        forward_batch: ForwardBatch,
+    ) -> Optional[torch.Tensor]:
+        """E4d: assemble the fused-cascade context for THIS shared layer.
+
+        The fused kernel (run in dsa_backend.forward_decode) attends over the
+        incumbent and re-derives the NEXT shared layer's index set from the same
+        QK^T. Here we build:
+          * incumbent (this layer's set) = the PREVIOUS fused layer's next_idx
+            (registry), or the copy+admission bootstrap for the first shared
+            layer; returned so the pipeline threads it normally;
+          * slot-space incumbent/window for the KV gather + attention;
+          * a native-space out_index_pool aligned with [incumbent ++ window] so
+            next_idx is emitted in the pipeline's index space (fallback-safe).
+        Returns None (fall back to the triton cascade) on any missing piece.
+        """
+        if prev_topk_indices is None:
+            return None
+        metadata = get_attn_backend().get_indexer_metadata(
+            self.layer_id, forward_batch
+        )
+        if metadata is None:
+            return None
+        from sglang.srt.layers.attention.dsa_backend import (
+            hh_get_fused_next_idx,
+            hh_tap_ar_group,
+        )
+
+        bsz, budget = prev_topk_indices.shape
+        device = prev_topk_indices.device
+        slot_space = self._hh_topk_is_slot_space()
+
+        # This layer's incumbent (NATIVE space): previous fused layer's next_idx,
+        # else bootstrap the first shared layer from copy + admission.
+        # The registry is GLOBAL across CUDA-graph captures of different batch
+        # sizes; a bsz-mismatched entry is STALE from a prior-bsz capture, not a
+        # valid incumbent -> treat it as a miss and bootstrap at the current bsz
+        # (else the first shared layer of the bs=2 graph reads a bs=1 entry and
+        # bails to the buggy triton fallback, crashing capture).
+        _reg = hh_get_fused_next_idx(self.layer_id - 1)
+        # is_bootstrap == first skip layer of a run (prev layer ran the indexer, so it did
+        # not write the registry). Within a skip run the recency window is identical, so we
+        # admit it ONCE here and let subsequent skip layers frozen-copy (see n_admit gate).
+        is_bootstrap = _reg is None or _reg.shape[0] != bsz
+        inc_native = _reg
+        if is_bootstrap:
+            inc_native = self._admit_reuse_indices(prev_topk_indices, forward_batch)
+        if inc_native is None or inc_native.shape[0] != bsz:
+            return None
+        inc_native = inc_native[:, :budget].to(prev_topk_indices.dtype)
+
+        # Incumbent in SLOT space for the KV gather / attention.
+        if slot_space:
+            inc_slots = inc_native
+        else:
+            mapped = self._hh_slots_for_positions(metadata, inc_native.clamp(min=0))
+            if mapped is None:
+                return None
+            inc_slots = mapped.masked_fill(inc_native < 0, -1)
+
+        # Window/sink admission set (SCORE-ONLY): positions [seqlen-W, seqlen)
+        # plus sinks [0, nsink). Native positions for the out-pool, slots for the
+        # KV gather; deduped vs the incumbent -> -1 so no key is double-counted.
+        window = getattr(self, "_index_reuse_window", 0)
+        nsink = getattr(self, "_index_reuse_nsink", 0)
+        n_admit = window + nsink
+        win_slots = None
+        win_native = None
+        # admit-once-per-run: only the first skip layer of a run re-ranks + admits the
+        # window; the rest frozen-copy (HH_TAP_ADMIT_EVERY=1 restores per-layer admission).
+        _admit_here = n_admit > 0 and (
+            is_bootstrap or _hh_os_fm.environ.get("HH_TAP_ADMIT_EVERY") == "1"
+        )
+        if _admit_here:
+            # The window/sink SLOTS are LAYER-INVARIANT within a forward (positions
+            # [seqlen-W, seqlen) + sinks, mapped through the same page table). Compute
+            # them ONCE per forward and cache on forward_batch; only the incumbent dedup
+            # below is layer-dependent. Recomputing the slot mapping per skip layer
+            # (~45/step) was the residual tap-window slowdown (audit 2026-08-04).
+            _wc = getattr(forward_batch, "_hh_win_base_cache", None)
+            if _wc is not None and _wc[0].shape[0] == bsz and _wc[0].shape[1] == n_admit:
+                win_base_slots, win_base_native = _wc
+            else:
+                seqlens = metadata.get_seqlens_int32()
+                offsets = torch.arange(n_admit, device=device, dtype=torch.int32)
+                pos = torch.where(
+                    offsets < nsink,
+                    offsets.unsqueeze(0).expand(bsz, -1),
+                    seqlens.unsqueeze(1) - (window + nsink) + offsets.unsqueeze(0),
+                ).clamp_(min=0)
+                raw_slots = self._hh_slots_for_positions(metadata, pos)
+                if raw_slots is None:
+                    return None
+                valid_pos = (pos < seqlens.unsqueeze(1)) & (seqlens.unsqueeze(1) > 0)
+                win_base_slots = raw_slots.masked_fill(~valid_pos, -1).to(
+                    prev_topk_indices.dtype
+                )
+                win_base_native = (
+                    win_base_slots
+                    if slot_space
+                    else pos.masked_fill(~valid_pos, -1).to(prev_topk_indices.dtype)
+                )
+                forward_batch._hh_win_base_cache = (win_base_slots, win_base_native)
+            # dedup window slots already present in THIS layer's incumbent (slot space)
+            # -> -1 so no key is double-attended. (Broadcast compare is the cheapest
+            # correct dedup here; torch.isin measured 3.5x slower. See KERNEL_WORK.md.)
+            dup = (win_base_slots.unsqueeze(2) == inc_slots.unsqueeze(1)).any(dim=2)
+            win_slots = win_base_slots.masked_fill(dup, -1)
+            win_native = win_base_native.masked_fill(dup, -1)
+
+        # Native-space output pool aligned with [incumbent ++ window]. The "tap" path
+        # consumes inc_native/win_native separately (no cat); the "fused" path wants the
+        # concatenated pool, so build it only there.
+        impl_is_tap = getattr(self, "_index_reuse_rerank_impl", "triton") == "tap"
+        if not impl_is_tap:
+            out_pool = inc_native if win_native is None else torch.cat([inc_native, win_native], dim=1)
+
+        tapw = getattr(self, "_hh_tap_w", None)
+        # dp_attention fix (job 24734): the tap-score AR must target the
+        # ATTENTION-TP group (the ranks that split q heads over the SAME local
+        # batch), not the full TP group -- under --enable-dp-attention the full
+        # TP group spans independently-scheduled dp ranks and the collective
+        # deadlocks. hh_tap_ar_group() returns the TP group itself under plain
+        # TP (behavior unchanged) and None when attn_tp_size == 1 (each rank
+        # holds all heads; nothing to reduce) -> all_reduce_fn is None and
+        # every downstream AR site is skipped. See its docstring.
+        _ar_group = (
+            hh_tap_ar_group()
+            if getattr(self, "_index_reuse_rerank_allreduce", True)
+            else None
+        )
+        all_reduce_fn = _ar_group.all_reduce if _ar_group is not None else None
+        # "tap" impl (kernel QK^T tap in the production flashmla_kv decode) stashes
+        # under a distinct attr so forward_decode routes it to _forward_tap_cascade;
+        # "fused" impl (research kernel) keeps _hh_fused_layers. Same ctx tuple.
+        attr = "_hh_tap_layers" if impl_is_tap else "_hh_fused_layers"
+        if not hasattr(forward_batch, attr):
+            setattr(forward_batch, attr, {})
+        if impl_is_tap and _admit_here:
