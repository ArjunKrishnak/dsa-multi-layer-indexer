+def hh_tap_ar_decision(
+    attn_tp_world_size: int,
+    attn_tp_is_full_tp: bool,
+    attn_tp_has_pynccl: bool,
+) -> str:
+    """Pure decision core for hh_tap_ar_group (CPU unit-tested; keep in sync).
+
+    Returns "run" (all-reduce over the attention-TP group) or "skip"
+    (world_size 1: each rank already holds every q head, the local head-sum is
+    complete, and there is nothing to reduce). Raises NotImplementedError for
+    the untested strict-subgroup-without-pynccl configuration instead of
+    risking a silent CUDA-graph hang (fail-fast).
+    """
+    if attn_tp_world_size == 1:
+        return "skip"
+    if not attn_tp_is_full_tp and not attn_tp_has_pynccl:
+        # 1 < attn_tp_size < tp_size (dp_attention with dp_size < tp_size):
+        # parallel_state.graph_capture() manages pynccl capture state only for
+        # _TP/_PP/_DCP/_MOE_EP/_MOE_TP, NOT _ATTN_TP, so without a pynccl
+        # communicator the in-place AR would fall through to
+        # torch.distributed.all_reduce inside CUDA-graph capture — an untested
+        # path whose failure mode is a hang, not an error. Refuse loudly.
+        raise NotImplementedError(
+            "tap all-reduce over a strict attention-TP subgroup "
+            f"(attn_tp_size={attn_tp_world_size}) without a pynccl "
+            "communicator is untested under CUDA-graph capture; refusing to "
+            "run (failure mode would be a silent hang). Supported today: "
+            "plain TP (attn_tp_size == tp_size) and dp_size == tp_size "
+            "(attn_tp_size == 1, all-reduce skipped)."
+        )
+    return "run"
+
+
+def hh_tap_ar_group():
+    """Communication group for the tap-score all-reduce, or None to skip it.
+
+    The tap head-sum is partial only across the ranks that SPLIT the q heads,
+    i.e. the ATTENTION-TP group (deepseek_v2.py: num_local_heads =
+    num_heads // attn_tp_size) — not the full TP group. Under plain TP the two
+    are the same object (parallel_state.py: _ATTN_TP = _TP when
+    attn_tp_size == tp_size), so using it here is behavior-identical to the
+    old get_tp_group() call. Under --enable-dp-attention the full TP group
+    additionally spans attention-DP ranks whose schedulers batch
+    INDEPENDENTLY: a full-TP collective is then entered by some ranks and not
+    others (or with mismatched shapes) -> scheduler deadlock, watchdog timeout
+    with no NCCL error (job 24734). It would also be semantically wrong —
+    those ranks hold DIFFERENT requests, so summing their tap scores mixes
+    unrelated batches.
+
+    Returns None when the attention-TP group has world_size 1 (e.g.
+    dp_size == tp_size): the local head-sum is already complete and the
+    all-reduce must be skipped.
+    """
+    from sglang.srt.distributed import get_attn_tp_group, get_tp_group
+
+    group = get_attn_tp_group()
+    decision = hh_tap_ar_decision(
+        attn_tp_world_size=group.world_size,
+        attn_tp_is_full_tp=group is get_tp_group(),
+        attn_tp_has_pynccl=getattr(group, "pynccl_comm", None) is not None,
+    )
+    return group if decision == "run" else None
+
