+# --- reuse_fused slice 2: deferred refresh-indexer join -----------------------
+# index_reuse_lag_refresh_deferred moves the refresh layer's fresh-set indexer
+# (whose output nothing in the CURRENT layer consumes under the lag handoff)
+# onto a dedicated side stream; the join is deferred to the NEXT layer's
+# forward_absorb_prepare entry, past this layer's attention + o_proj + MLP/MoE
+# -- every consumer of the carried set sits after that point. A DEDICATED
+# stream rather than the shared alt_stream: the MoE shared-expert overlap
+# enqueues on alt_stream and joins it within the same layer, so parking O(L)
+# indexer work there would re-serialize the step.
+_HH_LAG_IDX_STREAM = None
+
+
+def hh_lag_idx_stream():
+    global _HH_LAG_IDX_STREAM
+    if _HH_LAG_IDX_STREAM is None:
+        if torch.cuda.is_current_stream_capturing():
+            # Stream creation is not a capturable op; deepseek_v2 knob parsing
+            # pre-creates the stream at model init when the knob is on.
+            raise RuntimeError(
+                "hh_lag_idx_stream() first call landed inside CUDA graph "
+                "capture; it must be pre-created at model init"
+            )
+        # HH_LAG_STREAM_PRIORITY=-1 gives the deferred indexer's stream CUDA high
+        # priority: its blocks get scheduled ahead of the MoE/attention work it
+        # overlaps, so the join at the next layer stalls less (hiding-completeness
+        # lever; default 0 = the certified Aug-26 behaviour).
+        _prio = int(_hh_os.environ.get("HH_LAG_STREAM_PRIORITY", "0"))
+        _HH_LAG_IDX_STREAM = torch.cuda.Stream(priority=_prio)
+        logger.info("[lag_refresh_deferred] side stream created with priority=%d", _prio)
+    return _HH_LAG_IDX_STREAM
+
+
+def hh_lag_stash_pending(forward_batch, refs: tuple) -> None:
+    """Register the in-flight deferred indexer for this forward.
+
+    Single-slot by construction: every layer joins at prepare entry before a
+    new dispatch can be issued, so a second registration means a missed join
+    -- fail loud rather than risk a capture-time alias -> replay-time race.
+    """
+    if getattr(forward_batch, "_hh_lag_refresh_pending", None) is not None:
+        raise RuntimeError(
+            "lag_refresh_deferred: a deferred indexer is already pending -- "
+            "the prepare-entry join was skipped (layer ordering bug)"
+        )
+    forward_batch._hh_lag_refresh_pending = refs
+
+
+def hh_lag_join_pending(forward_batch) -> None:
+    """Join the deferred refresh-layer indexer, if one is in flight.
+
+    Waits the dedicated stream on the CURRENT stream (inside graph capture
+    this records a cross-stream dependency edge), then releases the held
+    input/output references: their frees now happen AFTER the join edge, so
+    the caching allocator cannot hand their memory to a later op that would
+    race the deferred reads (a capture-time alias is a replay-time race).
+    """
+    if getattr(forward_batch, "_hh_lag_refresh_pending", None) is None:
+        return
+    torch.cuda.current_stream().wait_stream(hh_lag_idx_stream())
+    forward_batch._hh_lag_refresh_pending = None
+
+
+# --- lag depth k (index_reuse_lag_depth >= 2): FIFO of deferred indexers ------
+# With depth k the deferred fresh-set indexer of refresh layer R_n is joined
+# at refresh layer R_{n+k} (k refresh layers later) instead of at the next
+# layer's prepare entry, so it overlaps k refresh spans of attention + o_proj
+# + MoE. Up to k entries are in flight on the ONE side stream; each entry
+# carries a CUDA event recorded right after ITS indexer, and the join waits on
+# that event alone -- a plain wait_stream() would also wait on the younger
+# entries still running on the same side stream and collapse the window back
+# to k=1. Inside graph capture the event record/wait pair is captured as a
+# cross-stream dependency edge exactly like wait_stream (which is implemented
+# with the same pair). The held input/output references of an entry are
+# released only when the entry is popped AFTER its wait edge, preserving the
+# k=1 allocator-lifetime discipline for every queued entry. The attribute is
+# distinct from the k=1 single slot (_hh_lag_refresh_pending) so the depth-1
+# path is untouched.
+# Entry layout: (layer_id, done_event, fresh_topk, (hidden_states, q_lora,
+# positions)).
+
+
+def hh_lag_queue_len(forward_batch) -> int:
+    q = getattr(forward_batch, "_hh_lag_refresh_queue", None)
+    return 0 if q is None else len(q)
+
+
+def hh_lag_queue_push(forward_batch, entry: tuple, depth: int) -> None:
+    """Append this refresh layer's in-flight deferred indexer (FIFO tail).
+
+    The dispatch joins the oldest entry BEFORE pushing whenever the queue is
+    full, so a push that would exceed ``depth`` means a join was skipped --
+    fail loud (a missed join is a capture-time alias -> replay-time race).
+    """
+    q = getattr(forward_batch, "_hh_lag_refresh_queue", None)
+    if q is None:
+        q = []
+        forward_batch._hh_lag_refresh_queue = q
+    if len(q) >= depth:
+        raise RuntimeError(
+            "lag_depth: deferred-indexer queue overflow (len=%d, depth=%d) -- "
+            "a refresh layer pushed without joining the oldest entry "
+            "(layer ordering bug)" % (len(q), depth)
+        )
+    q.append(entry)
+
+
+def hh_lag_queue_join_oldest(forward_batch):
+    """Pop the OLDEST in-flight entry, wait the current stream on its done
+    event (captured as a dependency edge under graph capture), and return its
+    fresh top-k set. The popped entry's held references die with the caller's
+    use of the returned set, i.e. after the wait edge."""
+    q = getattr(forward_batch, "_hh_lag_refresh_queue", None)
+    if not q:
+        raise RuntimeError(
+            "lag_depth: join requested on an empty deferred-indexer queue"
+        )
+    _layer_id, done_event, fresh_topk, _held = q.pop(0)
+    torch.cuda.current_stream().wait_event(done_event)
+    return fresh_topk
+
+
+def hh_lag_queue_drain(forward_batch) -> None:
+    """End-of-model failsafe: join EVERY in-flight entry (the last k refresh
+    layers of the stack have no later refresh layer to join them) so no
+    forward -- and no graph capture -- ends on a dangling side-stream branch.
+    No-op when nothing is queued."""
+    q = getattr(forward_batch, "_hh_lag_refresh_queue", None)
+    if not q:
+        return
+    torch.cuda.current_stream().wait_stream(hh_lag_idx_stream())
+    q.clear()
+
