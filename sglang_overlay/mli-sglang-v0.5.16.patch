--- /dev/null
+++ b/python/sglang/srt/layers/attention/dsa/hh_fused_decode.py
@@ -0,0 +1,799 @@
+"""E4d Milestone 4: fused-cascade decode wrapper.
+
+Wraps the certified attention-epilogue fused-cascade CUDA kernel
+(``bench/cuda_fused_sparse_splitk.py`` in the research repo) into a single
+sglang-shaped entry point, ``_hh_fused_cascade_decode``.
+
+The kernel (``launch_fused_sparse_splitk_batch`` with ``with_select=3``) is the
+TAP CASCADE: one launch computes sparse-MLA attention over the ATTENDED
+(incumbent) key set AND re-derives the next index set from attention's own QK^T
+scores over the incumbent ∪ admission-window union (the fp8 indexer is never
+dereferenced in mode 3).  This replaces the side-kernel tap in
+``hh_cascade_triton.py`` (a second launch that host-syncs and loses to copy).
+
+Serving cascade semantics (the correctness point):
+  * attention runs over the INCUMBENT top-k only (``Indices`` = the incumbent
+    slots' compact positions);
+  * selection is scored over incumbent ∪ FRESH recency-window ∪ sink — the
+    window/sink keys are SCORE-ONLY (they do not perturb attention).  They are
+    laid out as the ``win`` positional tail of the contiguous buffer, exactly
+    the kernel's cascade window.
+
+Layout of the per-batch contiguous buffer ``kvb[B, topk+W, dqk]``:
+  * positions ``[0, topk)``          = gathered incumbent (attended) keys;
+  * positions ``[topk, topk+W)``     = gathered window/sink (score-only) keys.
+With ``Skv = topk+W`` and ``q_pos = Skv-1``, the kernel's window ``w_lo = topk``
+covers exactly the score-only block, so the tap scores the incumbent columns
+plus the window block and the top-k over that union re-derives ``next_idx``.
+
+Imports of the research kernel are lazy so this module imports cleanly when the
+research repo is not mounted (the eager/triton paths still work).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+
+import torch
+
+from sglang.kernels.ops.attention.dsa.dequant_k_cache import dequantize_k_cache
+
+logger = logging.getLogger(__name__)
+
+# Env-gated in-server HIDE parity check (HH_HIDE_PARITY=1): on the first few lag
+# decode calls, compare the fused kernel's full-prefix indexer top-k against a
+# faithful fp32 mirror of the SAME fp8 operands (the stock lightning-indexer
+# math), proving the in-server operand plumbing is bit-exact. Off by default.
+_HIDE_PARITY_MAX = int(os.environ.get("HH_HIDE_PARITY_MAX", "4"))
+_hide_parity_calls = 0
+
+# Packed byte-width of one fp8-quantized latent KV row:
+#   [nope_fp8 (512) | nope_scales (4 tiles x fp32 = 16) | rope_bf16 (64 x 2 = 128)] = 656.
+# The bf16 latent row is 512 (nope) + 64 (rope) = 576. Detect fp8 storage by width.
+_FP8_QUANT_ROW_BYTES = 656
+
+# --- lazy, process-cached handle to the compiled research kernel -------------
+
+_EXT = None
+_CFG = None
+
+
+def _kernel_ext():
+    """Compile-or-load and cache the fused-sparse-splitk CUDA extension.
+
+    Relies on the serving container mounting the research repo at ``/research``
+    with ``PYTHONPATH=/research/src:/research/bench`` and a warm
+    ``TORCH_EXTENSIONS_DIR`` (the ~37s nvcc build is cached at /hh/.torch_ext_e4d).
+    """
+    global _EXT, _CFG
+    if _EXT is None:
+        from cuda_fused_sparse_splitk import build  # type: ignore
+        from lagged_indexer_dsa.config import named_config  # type: ignore
+
+        _EXT = build()
+        _CFG = named_config("deepseek")
+    return _EXT, _CFG
+
+
+def _make_dummy_indexer_operands(B, Skv, Hidx, didx, device):
+    """The fp8 indexer operands are required kernel args but are NEVER
+    dereferenced in ``with_select=3`` (attention re-derives selection from its
+    own QK^T).  Build correctly-shaped zero tensors so the launch validates."""
+    iqf8 = torch.zeros(B, Hidx, didx, dtype=torch.float8_e4m3fn, device=device)
+    ikf8 = torch.zeros(Skv, didx, dtype=torch.float8_e4m3fn, device=device)
+    wp = torch.zeros(B, Hidx, dtype=torch.float32, device=device)
+    sk = torch.zeros(Skv, dtype=torch.float32, device=device)
+    return iqf8, ikf8, wp, sk
+
+
+def _hh_fused_cascade_decode(
+    q_all: torch.Tensor,
+    kv_pool: torch.Tensor,
+    incumbent_slots: torch.Tensor,
+    window_slots: torch.Tensor | None,
+    tapw: torch.Tensor,
+    sm_scale: float,
+    nsplit: int = 16,
+    all_reduce_fn=None,
+    out_index_pool: torch.Tensor | None = None,
+):
+    """One fused launch: sparse-MLA attention over the incumbent + next-index
+    re-derivation over incumbent ∪ window/sink.
+
+    Args:
+        q_all: ``[1, B, H, dqk]`` bf16 decode queries (dqk = 512 + 64 = 576).
+        kv_pool: ``[S_pool, dqk]`` bf16 latent KV cache (slot-addressed).
+        incumbent_slots: ``[B, topk]`` int slots into ``kv_pool`` = each row's
+            ATTENDED key set.  ``< 0`` / ``>= S_pool`` = empty slot (dropped from
+            attention via the ``Skv`` sentinel).
+        window_slots: ``[B, W]`` int slots = SCORE-ONLY fresh recency-window +
+            sink keys (already deduped vs the incumbent; ``< 0`` = empty, masked
+            out of selection).  ``None`` / width 0 = no admission (verbatim
+            re-rank of the incumbent only).
+        tapw: ``[H]`` fp32 per-head tap weights.
+        sm_scale: attention softmax scale.
+        nsplit: split-K factor (grid occupancy); 16 in the certified config.
+
+    Returns:
+        attn_out: ``[1, B, H, 512]`` bf16 sparse-MLA attention output (incumbent).
+        next_idx: ``[B, topk]`` int64 next index set in ORIGINAL pool-slot space
+            (``-1`` padded), re-derived from attention's QK^T tap over the union.
+    """
+    ext, cfg = _kernel_ext()
+    Hidx, didx = cfg.index_n_heads, cfg.index_head_dim
+
+    assert q_all.dim() == 4 and q_all.shape[0] == 1, f"q_all must be [1,B,H,dqk], got {tuple(q_all.shape)}"
+    _, B, H, dqk = q_all.shape
+    device = q_all.device
+    # Head-geometry workaround (e.g. GLM-5: 64 heads / TP8 = 8/rank): the fused
+    # split-K kernel tiles attention in 16-head blocks (H % 16 == 0). Zero-pad the
+    # attention heads up to the next multiple of 16 -- attention is per-head
+    # independent so the real heads are exact, padded heads carry tapw=0 (below) so
+    # they never enter selection, and attn_out is sliced back to H_real on return.
+    H_real = H
+    H = ((H + 15) // 16) * 16
+    if H != H_real:
+        q_all = torch.cat(
+            [q_all, torch.zeros(1, B, H - H_real, dqk, dtype=q_all.dtype, device=device)],
+            dim=2,
+        ).contiguous()
+    topk = incumbent_slots.shape[1]
+    assert incumbent_slots.shape[0] == B, f"incumbent batch {incumbent_slots.shape[0]} != q batch {B}"
+    S_pool, dqk_pool = kv_pool.shape
+    # The latent cache is either bf16 (row width == q dqk == 576) or fp8-quantized
+    # (row width == 656 uint8-packed [nope_fp8|scales|rope_bf16]). The fp8 slice is
+    # dequantized AFTER the gather below, so accept either width here.
+    kv_is_fp8_quant = dqk_pool == _FP8_QUANT_ROW_BYTES
+    assert dqk_pool == dqk or kv_is_fp8_quant, (
+        f"kv_pool dqk {dqk_pool} != q dqk {dqk} and != fp8 packed row {_FP8_QUANT_ROW_BYTES}"
+    )
+    if kv_is_fp8_quant:
+        assert dqk == 576, (
+            f"fp8 dequant emits a 576-dim bf16 latent, but q dqk is {dqk}"
+        )
+
+    W = 0 if window_slots is None else window_slots.shape[1]
+    Skv = topk + W
+    win = max(W, 1)          # kernel needs win>=1 for the cascade epilogue plane
+    ntap = topk + win
+    nblk = H // 16
+    kv_stride = Skv * dqk
+
+    if tapw is None:
+        tapw = torch.ones(H_real, dtype=torch.float32, device=device)
+    if tapw.shape[0] == H_real and H != H_real:
+        # padded heads get zero tap weight -> excluded from cascade selection
+        tapw = torch.cat([tapw, torch.zeros(H - H_real, dtype=tapw.dtype, device=device)])
+
+    inc = incumbent_slots.long()
+    inc_valid = (inc >= 0) & (inc < S_pool)
+
+    if W > 0:
+        ws = window_slots.long()
+        win_valid = (ws >= 0) & (ws < S_pool)
+        combined = torch.cat([inc, ws], dim=1)                 # [B, Skv] pool slots
+        combined_valid = torch.cat([inc_valid, win_valid], dim=1)
+    else:
+        win_valid = None
+        combined = inc
+        combined_valid = inc_valid
+
+    # --- paged-KV gather: kv_pool[combined] -> per-batch contiguous KV --------
+    # The kernel is bf16-only. The serving latent cache is stored either as bf16
+    # (row width 576) or fp8-quantized (row width 656). We gather ONLY the ~topk+W
+    # slots per layer, so dequantizing the gathered slice is cheap (vs flashmla's
+    # whole-cache requant that this path avoids). Gather is graph-capture-safe:
+    # static shapes ([B*Skv, dqk_pool]), no host syncs.
+    safe = combined.clamp(0, S_pool - 1)
+    gathered = kv_pool.index_select(0, safe.reshape(-1))  # [B*Skv, dqk_pool]
+    if kv_is_fp8_quant:
+        # fp8 layout: dequantize the gathered slice -> 576-dim bf16 latent.
+        # dequantize_k_cache expects (num_blocks, block_size=1, 656) fp8 and
+        # returns (num_blocks, 1, 576) bf16. It allocates a static-shape output
+        # and launches a triton kernel (grid = (B*Skv, 5)) — capture-safe.
+        quant_rows = gathered
+        if quant_rows.dtype == torch.uint8:
+            quant_rows = quant_rows.view(torch.float8_e4m3fn)
+        deq = dequantize_k_cache(quant_rows.unsqueeze(1))  # [B*Skv, 1, 576] bf16
+        kvb = deq.reshape(B, Skv, dqk)
+    else:
+        kvb = gathered.reshape(B, Skv, dqk)
+        if kvb.dtype != torch.bfloat16:
+            kvb = kvb.to(torch.bfloat16)
+    kvb = kvb.contiguous()
+
+    # incumbent indices = identity into the compact buffer; invalid incumbent
+    # slots get the Skv sentinel so the kernel's causal guard (idx <= Skv-1)
+    # drops them from attention.  When W==0 the buffer is exactly the incumbent
+    # and the (unused) 1-wide window tail scores an extra copy of position 0,
+    # which we mask out of selection below.
+    ar = torch.arange(topk, device=device, dtype=torch.int32)
+    indices = ar.unsqueeze(0).expand(B, topk).contiguous()
+    indices[~inc_valid] = Skv
+
+    iqf8, ikf8, wp, sk = _make_dummy_indexer_operands(B, Skv, Hidx, didx, device)
+
+    # --- kernel scratch + outputs --------------------------------------------
+    nb = B * nblk * nsplit
+    part_acc = torch.zeros(nb, 16, 512, dtype=torch.float32, device=device)
+    part_m = torch.zeros(nb, 16, dtype=torch.float32, device=device)
+    part_l = torch.zeros(nb, 16, dtype=torch.float32, device=device)
+    sel_slab = torch.zeros(nblk * B * ntap, dtype=torch.float32, device=device)
+    sel_hist = torch.zeros(B, 256, dtype=torch.int32, device=device)
+    tapw = tapw.to(torch.float32).contiguous()
+    attn_out = torch.zeros(1, B, H, 512, dtype=torch.bfloat16, device=device)
+
+    ext.launch_fused_sparse_splitk_batch(
+        q_all, kvb, indices, iqf8, ikf8, wp, sk,
+        part_acc, part_m, part_l, sel_slab, sel_hist, tapw, attn_out,
+        B, Skv, H, Hidx, topk, topk, nsplit, sm_scale, 3, win, kv_stride,
+    )
+
+    # --- fold tap planes -> union logits, top-k -> next index set -------------
+    tap_out = torch.zeros(B, ntap, dtype=torch.float32, device=device)
+    ext.launch_cascade_epilogue_batch(sel_slab, indices, tap_out, B, nblk, topk, win, Skv)
+    # NB: no torch.cuda.synchronize() here — subsequent ops queue on the same
+    # stream, and a sync would break CUDA-graph capture (Step 4 graphs-on).
+
+    # TP selection consistency (frozen method): the per-rank tap holds only this
+    # rank's attention heads; all-reduce the union logits so every rank selects
+    # the IDENTICAL next set (matches _cascade_rerank_indices' all-reduce). The
+    # window/sink validity mask is rank-invariant, so masking after the reduce is
+    # safe (only -inf, never +inf, participates -> no NaN from inf-inf).
+    if all_reduce_fn is not None:
+        tap_out = all_reduce_fn(tap_out)
+
+    # Score-only columns [topk, topk+win) map to compact positions [topk, Skv);
+    # mask the ones whose window slot is invalid / a dedup hole (-1) so they can
+    # never be selected.  When W==0 the single synthetic window column is masked.
+    if W > 0:
+        tap_out[:, topk:topk + W] = tap_out[:, topk:topk + W].masked_fill(~win_valid, float("-inf"))
+    else:
+        tap_out[:, topk:] = float("-inf")
+
+    # slot top-k over the deduped union, then map compact positions -> pool slots.
+    # q_pos = Skv-1 for every decode row; window covers compact positions
+    # [w_lo, Skv-1] with w_lo = Skv-win.  With win==W we have w_lo == topk, so a
+    # window column top_slot maps to compact position top_slot directly; an
+    # incumbent column (top_slot < topk) maps to compact position top_slot too.
+    top_v, top_slot = tap_out.topk(topk, dim=-1)
+    w_lo = max(Skv - win, 0)
+    compact_pos = torch.where(top_slot < topk, top_slot, w_lo + (top_slot - topk))
+    compact_pos = compact_pos.clamp(0, Skv - 1)
+    # Emit next_idx in the caller's NATIVE space when an aligned out_index_pool is
+    # supplied (KV was gathered by slots; selection output must live in the space
+    # the serving pipeline threads between layers); else emit in kv_pool slots.
+    src_pool = combined if out_index_pool is None else out_index_pool.long()
+    next_idx = torch.gather(src_pool, 1, compact_pos)
+    # invalid-selection (finite guard) and invalid combined slot -> -1 padding
+    sel_valid = torch.gather(combined_valid, 1, compact_pos)
+    next_idx = torch.where(
+        torch.isfinite(top_v) & sel_valid, next_idx, torch.full_like(next_idx, -1))
+
+    if H != H_real:
+        attn_out = attn_out[:, :, :H_real, :].contiguous()
+    return attn_out, next_idx
+
+
+def _hh_fused_hide_decode(
+    q_all: torch.Tensor,
+    kv_pool: torch.Tensor,
+    incumbent_slots: torch.Tensor,
+    index_q_fp8: torch.Tensor,
+    index_weights: torch.Tensor,
+    index_k_fp8: torch.Tensor,
+    index_k_scale: torch.Tensor,
+    seqlen: int,
+    sm_scale: float,
+    nsplit: int = 16,
+    index_topk: int | None = None,
+    out_index_pool: torch.Tensor | None = None,
+):
+    """Paper "HIDE": ONE fused launch runs the REAL fp8 lightning indexer over
+    the full prefix CONCURRENTLY with sparse-MLA attention over the incumbent
+    (the one-layer cross-layer lag makes them independent), hiding the indexer
+    under attention.  Single-sequence entry (``with_select=1, attn_on=1``); b=1
+    only (max-running-requests=1), matching serving.
+
+    This differs from ``_hh_fused_cascade_decode`` (with_select=3, which ZEROS
+    the indexer operands and re-derives selection from attention's own QK^T tap):
+    HIDE consumes the REAL fp8 indexer operands and its next index set is the
+    top-k of the indexer's full-prefix bilinear logits — bit-identical to the
+    stock separate-indexer top-k on the same fp8 bytes.
+
+    Args:
+        q_all: ``[1, 1, H, dqk]`` bf16 decode query (dqk = 512 + 64 = 576, b=1).
+        kv_pool: ``[S_pool, dqk]`` bf16 or fp8-packed (656 B) latent KV cache.
+        incumbent_slots: ``[1, topk]`` int slots into ``kv_pool`` = the ATTENDED
+            key set (= L-1's index set under the lag).  ``< 0`` / ``>= S_pool`` =
+            empty (dropped from attention via the ``Skv`` sentinel).
+        index_q_fp8: ``[1, Hidx, didx]`` fp8_e4m3 indexer query (serving's
+            ``q_fp8`` from ``fused_q_indexer_rope_first_quant``).
+        index_weights: ``[1, Hidx]`` fp32 per-head gates (serving's ``weights``;
+            already carries the per-head q-scale * softmax_scale * n_heads**-0.5,
+            a positive rescale that never changes the selected SET).
+        index_k_fp8: ``[seqlen, didx]`` fp8_e4m3 CONTIGUOUS indexer keys over the
+            full prefix (from ``get_index_k_continuous`` — the paged, scale-packed
+            index-K buffer unpacked to a dense [seq, 128] tensor).
+        index_k_scale: ``[seqlen]`` fp32 per-key dequant scale (from
+            ``get_index_k_scale_continuous``).
+        seqlen: full prefix length = ``Skv`` (drives q_pos and the indexer scan).
+        sm_scale: attention softmax scale.
+        index_topk: number of next indices to select (default = ``topk``).
+        out_index_pool: ``[1, seqlen]`` next_idx output space (native positions);
+            default = identity (prefix positions ``0..seqlen-1``).
+
+    Returns:
+        attn_out: ``[1, 1, H, 512]`` bf16 sparse-MLA attention over the incumbent.
+        next_idx: ``[1, index_topk]`` int64 next index set (top-k of the fp8
+            indexer's full-prefix logits), in ``out_index_pool`` space, -1 padded.
+    """
+    ext, cfg = _kernel_ext()
+    Hidx, didx = cfg.index_n_heads, cfg.index_head_dim
+
+    assert q_all.dim() == 4 and q_all.shape[0] == 1 and q_all.shape[1] == 1, (
+        f"HIDE is single-sequence (b=1): q_all must be [1,1,H,dqk], got {tuple(q_all.shape)}"
+    )
+    _, _, H, dqk = q_all.shape
+    device = q_all.device
+    # Head-geometry workaround (see _hh_fused_cascade_decode): pad attention heads
+    # to a multiple of 16 for the fused kernel. HIDE selection is the fp8 indexer's
+    # full-prefix logits (independent of H), so padding only adds discarded
+    # attention heads, sliced off attn_out on return.
+    H_real = H
+    H = ((H + 15) // 16) * 16
+    if H != H_real:
+        q_all = torch.cat(
+            [q_all, torch.zeros(1, 1, H - H_real, dqk, dtype=q_all.dtype, device=device)],
+            dim=2,
+        ).contiguous()
+    topk = incumbent_slots.shape[1]
+    assert incumbent_slots.shape[0] == 1, f"HIDE b=1; incumbent batch {incumbent_slots.shape[0]}"
+    assert seqlen >= 1, f"seqlen must be >= 1, got {seqlen}"
+    if index_topk is None:
+        index_topk = topk
+
+    # --- operand shape/dtype guards (the kernel's validate() layout) ----------
+    assert index_q_fp8.shape == (1, Hidx, didx), (
+        f"index_q_fp8 must be [1,{Hidx},{didx}], got {tuple(index_q_fp8.shape)}"
+    )
+    assert index_q_fp8.dtype == torch.float8_e4m3fn, f"index_q_fp8 dtype {index_q_fp8.dtype}"
+    assert index_weights.shape == (1, Hidx), (
+        f"index_weights must be [1,{Hidx}], got {tuple(index_weights.shape)}"
+    )
+    assert index_k_fp8.shape == (seqlen, didx), (
+        f"index_k_fp8 must be [{seqlen},{didx}], got {tuple(index_k_fp8.shape)}"
+    )
+    assert index_k_fp8.dtype == torch.float8_e4m3fn, f"index_k_fp8 dtype {index_k_fp8.dtype}"
+    assert index_k_scale.shape == (seqlen,), (
+        f"index_k_scale must be [{seqlen}], got {tuple(index_k_scale.shape)}"
+    )
+
+    S_pool, dqk_pool = kv_pool.shape
+    kv_is_fp8_quant = dqk_pool == _FP8_QUANT_ROW_BYTES
+    assert dqk_pool == dqk or kv_is_fp8_quant, (
+        f"kv_pool dqk {dqk_pool} != q dqk {dqk} and != fp8 packed row {_FP8_QUANT_ROW_BYTES}"
+    )
+
+    # Sentinel for the attention causal guard: identity indices [0,topk) index a
+    # COMPACT gathered buffer, so q_pos = Skv-1 = seqlen-1 >> topk-1 keeps every
+    # valid identity slot causal; invalid incumbent slots get the Skv sentinel
+    # (> q_pos) so the kernel drops them from softmax.
+    inc = incumbent_slots.long()
+    inc_valid = (inc >= 0) & (inc < S_pool)
+
+    # --- paged-KV gather: only the incumbent (attended) topk rows -------------
+    # Attention reads KV solely at the Indices positions, so we gather+dequant
+    # just the topk incumbent rows into a compact bf16 buffer and remap Indices
+    # to identity (exactly the cascade path); the indexer uses index_k_fp8, not
+    # this buffer.  Static shapes, no host syncs -> CUDA-graph capture safe.
+    safe = inc.clamp(0, S_pool - 1)
+    gathered = kv_pool.index_select(0, safe.reshape(-1))  # [topk, dqk_pool]
+    if kv_is_fp8_quant:
+        assert dqk == 576, f"fp8 dequant emits a 576-dim bf16 latent, but q dqk is {dqk}"
+        quant_rows = gathered
+        if quant_rows.dtype == torch.uint8:
+            quant_rows = quant_rows.view(torch.float8_e4m3fn)
+        deq = dequantize_k_cache(quant_rows.unsqueeze(1))  # [topk, 1, 576] bf16
+        kvb = deq.reshape(1, topk, 1, dqk)
+    else:
+        kvb = gathered.reshape(1, topk, 1, dqk)
+        if kvb.dtype != torch.bfloat16:
+            kvb = kvb.to(torch.bfloat16)
+    kvb = kvb.contiguous()
+
+    # incumbent -> identity into the compact buffer; invalid slots -> Skv sentinel
+    ar = torch.arange(topk, device=device, dtype=torch.int32)
+    indices = ar.unsqueeze(0).contiguous()                  # [1, topk]
+    indices[~inc_valid] = seqlen
+
+    # --- real fp8 indexer operands (the HIDE difference vs cascade) -----------
+    iqf8 = index_q_fp8.contiguous()
+    ikf8 = index_k_fp8.contiguous()
+    wp = index_weights.to(torch.float32).contiguous()
+    sk = index_k_scale.to(torch.float32).contiguous()
+
+    # --- kernel scratch + outputs (single-seq, S=1) --------------------------
+    nblk = H // 16
+    nb = nblk * nsplit
+    part_acc = torch.zeros(nb, 16, 512, dtype=torch.float32, device=device)
+    part_m = torch.zeros(nb, 16, dtype=torch.float32, device=device)
+    part_l = torch.zeros(nb, 16, dtype=torch.float32, device=device)
+    # with_select=1 writes indexer logits into SelSlab as [S=1, Skv=seqlen].
+    sel_slab = torch.zeros(seqlen, dtype=torch.float32, device=device)
+    sel_hist = torch.zeros(1, 256, dtype=torch.int32, device=device)  # unused in mode 1
+    attn_out = torch.zeros(1, 1, H, 512, dtype=torch.bfloat16, device=device)
+
+    q_in = q_all.contiguous()
+    ext.launch_fused_sparse_splitk(
+        q_in, kvb, indices, iqf8, ikf8, wp, sk,
+        part_acc, part_m, part_l, sel_slab, sel_hist, attn_out,
+        1, seqlen, H, Hidx, topk, nsplit, float(sm_scale),
+        1, 1, 0,  # with_select=1 (real indexer ON), attn_on=1, win=0 -> HIDE
+    )
+
+    # --- top-k over the full-prefix indexer logits -> next index set ----------
+    # q_pos = seqlen-1, so every prefix position is causal; the kernel already
+    # zeroed acausal/out-of-range slots. Select the top index_topk positions.
+    logits = sel_slab.view(1, seqlen)
+    k = min(index_topk, seqlen)
+    top_v, top_pos = torch.topk(logits, k, dim=-1)          # compact positions
+
+    # --- env-gated in-server parity: fused indexer vs fp32 mirror -------------
+    # Fires only at a DISCRIMINATING context (seqlen > 4096, so the top-k is a
+    # real subset). Reports BOTH the top-k SET agreement AND the logit 1-corr:
+    # the correlation is tie-break-independent, so it is the true bit-exactness
+    # signal (with --load-format dummy the logits are near-degenerate, so SET
+    # agreement can dip on ties while 1-corr stays ~0 = arithmetically exact).
+    global _hide_parity_calls
+    if (
+        os.environ.get("HH_HIDE_PARITY") == "1"
+        and _hide_parity_calls < _HIDE_PARITY_MAX
+        and seqlen > 4096
+    ):
+        _hide_parity_calls += 1
+        with torch.no_grad():
+            # Faithful fp32 mirror of the SAME fp8 bytes (stock lightning-indexer
+            # math): logits[g] = (ReLU(q·k)·wp).sum_h · sk[g].
+            bil = torch.einsum("hd,gd->hg", iqf8.float()[0], ikf8.float())  # [Hidx, seqlen]
+            ref_logits = (bil.relu() * wp.float()[0].unsqueeze(-1)).sum(0) * sk.float()
+            fused_logits = logits[0].float()
+            a, b = fused_logits.double(), ref_logits.double()
+            n = (a * a + b * b).sum()
+            logit_1corr = 0.0 if float(n) == 0 else float(1.0 - 2 * (a * b).sum() / n)
+            ref_top = torch.topk(ref_logits.view(1, seqlen), k, dim=-1).indices
+            agree = len(set(top_pos[0].tolist()) & set(ref_top[0].tolist())) / max(k, 1)
+            logger.warning(
+                "[HIDE-parity call=%d] seqlen=%d topk=%d SET-agree=%.6f "
+                "logit-1corr=%.3e fused_max=%.4e ref_max=%.4e",
+                _hide_parity_calls, seqlen, k, agree, logit_1corr,
+                float(fused_logits.max()), float(ref_logits.max()),
+            )
+    if out_index_pool is None:
+        next_idx = top_pos.long()
+    else:
+        next_idx = torch.gather(out_index_pool.long(), 1, top_pos)
+    if k < index_topk:
+        pad = torch.full((1, index_topk - k), -1, dtype=next_idx.dtype, device=device)
+        next_idx = torch.cat([next_idx, pad], dim=1)
+
+    if H != H_real:
+        attn_out = attn_out[:, :, :H_real, :].contiguous()
+    return attn_out, next_idx
+
+
+# --- HIDE for serving: batched + CUDA-graph capturable (paged index-K) -------
+# Persistent scratch keyed by static shape. Allocated on first use and reused
+# on every call, so a CUDA-graph capture records fixed addresses (no
+# per-replay allocation) and eager calls share the same buffers.
+_HIDE_SCRATCH: dict = {}
+# Split-K factor of the fused launch. At TP=8 a rank holds 16 (DS) / 8 (GLM-5)
+# attention heads = ONE 16-head block, so the grid is B*nsplit blocks: nsplit
+# sets how much of the GPU the per-layer launch fills. Tuned by the L0 gate's
+# nsplit sweep; overridable per run for the serving cells.
+_HIDE_NSPLIT = int(os.environ.get("HH_HIDE_NSPLIT", "0"))   # 0 = auto: nsplit_attn + min(HH_HIDE_NIDX, 256 // B)
+_HIDE_NIDX = int(os.environ.get("HH_HIDE_NIDX", "128"))
+# Attention-bearing splits per row (<= nsplit). The remaining splits carry only
+# an indexer slice, so the prefix scan spreads over many blocks while attention
+# keeps its cheap 16-way split-K (the L0 sweep showed attention's cost grows
+# ~linearly with its own split count).
+_HIDE_NSPLIT_ATTN = int(os.environ.get("HH_HIDE_NSPLIT_ATTN", "32"))
+# Selection realization (v10 kernel):
+#   kernel  in-kernel row-cooperative top-k (production topk_v2 algorithm), next_idx
+#           written by the fused launch in KV-slot space -- no top-k launch at all;
+#   prod    the kernel writes only the logit slab; the caller runs the production
+#           fused paged top-k on it (the pre-v10 serving path, kept for A/B);
+#   torch   torch.topk over the slab (isolated gate only).
+#   exact   = kernel: row-cooperative exact select (histogram barrier + tie radix)
+#   approx  per-slice top-m (page-interleaved slices) + last-arriver exact merge
+#           over n_idx*m candidates -- no row barrier; m = HH_HIDE_APPROX_M
+#   prod_side  (default) the kernel writes only the logit slab; the backend runs
+#           the production fused paged top-k on a SIDE STREAM, overlapped with
+#           this layer's o_proj/MoE, joined at the next layer's prepare entry
+#           (the same fork/join as the deferred arm) -- exact, production-
+#           identical selection with no tail on the per-layer critical chain
+_HIDE_SELECT = os.environ.get("HH_HIDE_SELECT", "prod_side")
+if _HIDE_SELECT == "kernel":
+    _HIDE_SELECT = "exact"
+assert _HIDE_SELECT in ("exact", "approx", "prod", "prod_side", "torch"), f"HH_HIDE_SELECT={_HIDE_SELECT!r}"
+_HIDE_APPROX_M = int(os.environ.get("HH_HIDE_APPROX_M", "64"))
+_SEL_SCRATCH_WORDS = 1056 + 2 * 2048 + 2 * 8192   # per row: histogram + counters + tie buffer + candidates
+_KERNEL_SELECT_MODES = ("exact", "approx")
+
+
+def _hide_scratch(key: tuple, make):
+    buf = _HIDE_SCRATCH.get(key)
+    if buf is None:
+        buf = make()
+        _HIDE_SCRATCH[key] = buf
+    return buf
+
+
+def _hh_fused_hide_decode_paged(
+    q_all: torch.Tensor,
+    kv_pool: torch.Tensor,
+    incumbent_slots: torch.Tensor,
+    index_q_fp8: torch.Tensor,
+    index_weights: torch.Tensor,
+    index_k_paged: torch.Tensor,
+    page_table: torch.Tensor,
+    seq_lens: torch.Tensor,
+    skv_cap: int,
+    sm_scale: float,
+    out_index_pool: torch.Tensor,
+    nsplit: int | None = None,
+    index_topk: int | None = None,
+    nsplit_attn: int | None = None,
+    return_logits: bool = False,
+    select: bool | str = True,
+    mode: str = "full",
+):
+    """HIDE for serving: one fused launch per layer, batched, graph-capturable.
+
+    ``mode`` (lag_def_fusedattn decomposition, coordinator target 2026-09-03):
+      "full"      the paper HIDE launch: attention + full-prefix indexer scan in
+                  ONE launch on the current stream (scan welded to attention, on
+                  the critical path -- the arm that LOSES on the real MoE model).
+      "attn_only" ONLY the fused sparse-MLA attention over the incumbent set
+                  (``with_select=0, attn_on=1, nsplit==nsplit_attn`` -> no idle
+                  indexer blocks). ~3.8 us/layer (25.7%) faster than production
+                  FlashMLA on DS-V3.2 (L0 job 30420), bit-compatible (corr 7e-6).
+                  Returns ``attn_out`` only (no scan, no select). The caller runs
+                  the scan+select on the SIDE stream so it overlaps the MoE.
+      "scan_only" ONLY the fp8 indexer scan over the full prefix
+                  (``with_select=1, attn_on=0``) -> the ``[B, skv_cap]`` logit
+                  slab for the deferred top-k. No attention. Enqueue on the side
+                  stream to hide it under the MoE (as the deferred-stream arm does).
+
+    v10: with an fp8-packed ``kv_pool`` (serving) the kernel gathers and
+    dequantizes the attended rows itself (no index_select / dequant launch, no
+    slab fill, no index remap) and, under ``select="kernel"`` (default, env
+    ``HH_HIDE_SELECT``), selects the next index set in-kernel and returns it in
+    KV-slot space as int32 ``[B, topk]`` (-1 padded) -- the only per-layer GPU
+    work is the single launch. ``select="prod"`` (or ``False``) returns the
+    logit slab for the production top-k; ``select="torch"`` (or ``True``) runs
+    torch.topk over the slab (gate only).
+
+    ``return_logits=True`` additionally returns a copy of the ``[B, skv_cap]``
+    full-prefix indexer logits (-inf beyond each row's length) for the
+    in-server set check; off in serving. ``select=False`` skips the torch
+    top-k and returns ``(attn_out, logits_view)`` so the caller can run the
+    production fused paged top-k (``metadata.topk_transform``) on the slab,
+    which is what serving does; the torch top-k path is kept for the isolated
+    gate. The returned attention output is a VIEW of persistent scratch that
+    the next layer's launch overwrites: consume it before then (the o_proj
+    that follows on the same stream does).
+
+    Same semantics as ``_hh_fused_hide_decode`` (attention over the incumbent
+    + the REAL fp8 indexer over the full prefix -> next index set = top-k of
+    its logits, bit-identical to the stock separate-indexer top-k on the same
+    fp8 bytes), with three serving-grade differences:
+
+      * per-row prefix lengths come from ``seq_lens`` (device int32): the
+        kernel reads them, so a graph captured once at ``skv_cap`` replays
+        correctly as sequences grow and across ragged batch rows;
+      * the indexer scans the PAGED serving index-K cache through
+        ``page_table`` (64-token pages of [64 x 128 B fp8 keys][64 x fp32
+        scales]) -- no dense per-request unpack, no ``.item()``;
+      * every buffer is static-shaped from ``(B, skv_cap)``.
+
+    Args:
+        q_all: ``[1, B, H, dqk]`` bf16 decode queries (dqk = 576).
+        kv_pool: ``[S_pool, 576 | 656]`` latent KV cache (bf16 or fp8-packed).
+        incumbent_slots: ``[B, topk]`` int KV slots = each row's ATTENDED set.
+        index_q_fp8: ``[B, Hidx, 128]`` fp8_e4m3 indexer queries.
+        index_weights: ``[B, Hidx]`` fp32 folded head gates.
+        index_k_paged: ``[num_pages, 8448]`` uint8 index-K page buffer.
+        page_table: ``[B, pt_stride]`` int32 page ids (page-64 table).
+        seq_lens: ``[B]`` int32 prefix lengths (<= skv_cap).
+        skv_cap: static capacity (== pt_stride * 64 in serving).
+        out_index_pool: ``[B, >= skv_cap]`` position -> KV-slot map.
+    Returns:
+        attn_out ``[1, B, H, 512]`` bf16; next_idx ``[B, index_topk]`` int64
+        in ``out_index_pool`` space, ``-1`` padded.
+    """
+    ext, _ = _kernel_ext()
+    assert mode in ("full", "attn_only", "scan_only"), f"unknown mode={mode!r}"
+    if mode == "attn_only":
+        # attention-only: no scan, no select. Force nsplit == nsplit_attn so
+        # there are NO idle indexer blocks (the minimal, fastest attention grid).
+        sel_mode = "prod"                       # (unused: with_select=0)
+        nsplit_attn = _HIDE_NSPLIT_ATTN if nsplit_attn is None else nsplit_attn
+        nsplit = nsplit_attn
+        launch_with_select, launch_attn_on = 0, 1
+    elif mode == "scan_only":
+        # full-prefix indexer scan only (deferred side stream): logit slab out,
+        # no attention. attn_on=0 => every split is an indexer block.
+        sel_mode = "prod"
+        launch_with_select, launch_attn_on = 1, 0
+    else:
+        launch_with_select, launch_attn_on = 1, 1
+    if mode == "full":
+        if select is True:
+            sel_mode = _HIDE_SELECT
+        elif select is False:
+            sel_mode = "prod"
+        else:
+            sel_mode = "exact" if select == "kernel" else str(select)
+        if sel_mode == "prod_side":
+            sel_mode = "prod"   # the side-stream placement is the caller's business
+        assert sel_mode in ("exact", "approx", "prod", "torch"), sel_mode
+    B_rows = int(q_all.shape[1])
+    nblk_rows = (int(q_all.shape[2]) + 15) // 16   # head-groups per row (1 at TP=8)
+    if nsplit is None:
+        if _HIDE_NSPLIT > 0:
+            nsplit = _HIDE_NSPLIT
+        elif sel_mode == "exact":
+            # every row's indexer blocks spin on a row barrier, so the batch's
+            # rows must all fit the co-resident capacity (~264 blocks on H100)
+            # or rows serialize; 128 indexer blocks at B=1, 64 at B=4, 32 at B=8
+            nsplit = _HIDE_NSPLIT_ATTN + max(16, min(_HIDE_NIDX, 256 // max(B_rows, 1)))
+        elif sel_mode == "approx":
+            nsplit = _HIDE_NSPLIT_ATTN + max(16, _HIDE_NIDX // nblk_rows)   # no barrier; n_idx * m <= 8192
+        else:
+            # slab-only launch (production top-k elsewhere): the L0 sweep's fastest
+            # fused point at B=1 is 224 indexer blocks (nsplit 256)
+            nsplit = _HIDE_NSPLIT_ATTN + max(16, max(_HIDE_NIDX, 224) // nblk_rows)
+    if nsplit_attn is None:
+        nsplit_attn = min(_HIDE_NSPLIT_ATTN, nsplit)
+    assert 0 < nsplit_attn <= nsplit, f"nsplit_attn={nsplit_attn} must be in (0, nsplit={nsplit}]"
+    assert q_all.dim() == 4 and q_all.shape[0] == 1, (
+        f"q_all must be [1,B,H,dqk], got {tuple(q_all.shape)}"
+    )
+    _, B, H, dqk = q_all.shape
+    device = q_all.device
+    # Indexer geometry comes from the operands (GLM-5: 32 heads; DS-V3.2: 64),
+    # never from a hard-coded model preset.
+    assert index_q_fp8.dim() == 3 and index_q_fp8.shape[0] == B, (
+        f"index_q_fp8 must be [B={B},Hidx,didx], got {tuple(index_q_fp8.shape)}"
+    )
+    Hidx, didx = int(index_q_fp8.shape[1]), int(index_q_fp8.shape[2])
+    assert didx == 128 and Hidx % 16 == 0, f"unsupported indexer geometry Hidx={Hidx} didx={didx}"
+    assert index_q_fp8.dtype == torch.float8_e4m3fn, f"index_q_fp8 dtype {index_q_fp8.dtype}"
+    assert index_weights.shape == (B, Hidx), (
+        f"index_weights must be [B,Hidx]=({B},{Hidx}), got {tuple(index_weights.shape)}"
+    )
+    assert seq_lens.shape == (B,) and seq_lens.dtype == torch.int32, (
+        f"seq_lens must be int32 [B={B}], got {tuple(seq_lens.shape)} {seq_lens.dtype}"
+    )
+    assert page_table.dim() == 2 and page_table.shape[0] == B and page_table.dtype == torch.int32, (
+        f"page_table must be int32 [B={B}, pt_stride], got {tuple(page_table.shape)} {page_table.dtype}"
+    )
+    pt_stride = int(page_table.shape[1])
+    assert pt_stride * 64 >= skv_cap, f"page table ({pt_stride} pages) does not cover skv_cap={skv_cap}"
+    assert index_k_paged.dtype == torch.uint8 and index_k_paged.dim() == 2, (
+        f"index_k_paged must be uint8 [num_pages, page_bytes], got {index_k_paged.dtype} {tuple(index_k_paged.shape)}"
+    )
+    page_bytes = int(index_k_paged.shape[1])
+    assert page_bytes == 64 * 128 + 64 * 4, f"index-K page must be 8448 bytes, got {page_bytes}"
+    assert out_index_pool is None or (out_index_pool.shape[0] == B and out_index_pool.shape[1] >= skv_cap), (
+        f"out_index_pool must be [B={B}, >= {skv_cap}], got {tuple(out_index_pool.shape)}"
+    )
+
+    # Head-geometry workaround (see _hh_fused_cascade_decode): pad attention
+    # heads to a multiple of 16; padded heads are sliced off on return.
+    H_real = H
+    H = ((H + 15) // 16) * 16
+    if H != H_real:
+        # persistent zero-padded query buffer (no per-layer cat/alloc); the pad
+        # heads stay zero because only [:H_real] is ever written
+        qpad = _hide_scratch((str(device), B, H, dqk, "qpad"), lambda: torch.zeros(1, B, H, dqk, dtype=q_all.dtype, device=device))
+        qpad[:, :, :H_real, :].copy_(q_all)
+        q_all = qpad
+    q_all = q_all.contiguous()
+    topk = int(incumbent_slots.shape[1])
+    assert incumbent_slots.shape[0] == B, f"incumbent batch {incumbent_slots.shape[0]} != {B}"
+    if index_topk is None:
+        index_topk = topk
+
+    S_pool, dqk_pool = kv_pool.shape
+    kv_is_fp8_quant = dqk_pool == _FP8_QUANT_ROW_BYTES
+    assert dqk_pool == dqk or kv_is_fp8_quant, (
+        f"kv_pool dqk {dqk_pool} != q dqk {dqk} and != fp8 packed row {_FP8_QUANT_ROW_BYTES}"
+    )
+
+    key = (str(device), B, H, int(skv_cap), nsplit)
+    if kv_is_fp8_quant:
+        # --- fp8 pool consumed DIRECTLY by the kernel (v10) ------------------
+        # Indices = raw KV slots (int32; invalid < 0 / >= rows dropped in-kernel).
+        if incumbent_slots.dtype != torch.int32:
+            incumbent_slots = incumbent_slots.to(torch.int32)
+        indices = incumbent_slots.contiguous()
+        kvb = kv_pool if kv_pool.dtype == torch.uint8 else kv_pool.view(torch.uint8)
+        kv_fp8, kv_rows, kv_stride = 1, int(S_pool), 0
+    else:
+        # --- bf16 pool: compact gather of the attended rows (static) --------
+        inc = incumbent_slots.long()
+        inc_valid = (inc >= 0) & (inc < S_pool)
+        safe = inc.clamp(0, S_pool - 1)
+        kvb = kv_pool.index_select(0, safe.reshape(-1)).reshape(B, topk, dqk)
+        if kvb.dtype != torch.bfloat16:
+            kvb = kvb.to(torch.bfloat16)
+        kvb = kvb.contiguous()
+        # identity into the compact buffer; invalid slots -> capacity sentinel
+        # (> every row's q_pos, so the kernel drops them from softmax)
+        ar = _hide_scratch(key + ("ar", topk), lambda: torch.arange(topk, device=device, dtype=torch.int32).unsqueeze(0).expand(B, topk).contiguous())
+        sentinel = _hide_scratch(key + ("sent",), lambda: torch.full((1, 1), int(skv_cap), dtype=torch.int32, device=device))
+        indices = torch.where(inc_valid, ar, sentinel)
+        kv_fp8, kv_rows, kv_stride = 0, 0, int(topk * dqk)
+
+    # --- static scratch + outputs ------------------------------------------
+    # Partials need no zeroing: every attention-bearing split overwrites its
+    # slice, and idle splits write m=-inf so their PartAcc is never read. The
+    # slab needs no fill: the kernel writes the -inf tail of every row. The
+    # select scratch is zero at allocation and self-resetting per launch.
+    nblk = H // 16
+    nb = B * nblk * nsplit
+    part_acc = _hide_scratch(key + ("acc",), lambda: torch.zeros(nb, 16, 512, dtype=torch.float32, device=device))
+    part_m = _hide_scratch(key + ("m",), lambda: torch.zeros(nb, 16, dtype=torch.float32, device=device))
+    part_l = _hide_scratch(key + ("l",), lambda: torch.zeros(nb, 16, dtype=torch.float32, device=device))
+    sel_slab = _hide_scratch(key + ("slab",), lambda: torch.empty(B * int(skv_cap), dtype=torch.float32, device=device))
+    sel_hist = _hide_scratch(key + ("hist",), lambda: torch.zeros(B, 256, dtype=torch.int32, device=device))
+    attn_out = _hide_scratch(key + ("out",), lambda: torch.zeros(1, B, H, 512, dtype=torch.bfloat16, device=device))
+    sel_on = {"exact": 1, "approx": 2}.get(sel_mode, 0)
+    sel_scratch = _hide_scratch(key + ("selscratch",), lambda: torch.zeros(B, _SEL_SCRATCH_WORDS, dtype=torch.int32, device=device))
+    next_idx_buf = _hide_scratch(key + ("nextidx", topk), lambda: torch.full((B, topk), -1, dtype=torch.int32, device=device))
+
+    ext.launch_fused_sparse_splitk_paged(
+        q_all, kvb, indices, index_q_fp8.contiguous(), index_k_paged,
+        index_weights.to(torch.float32).contiguous(),
+        seq_lens.contiguous(), page_table.contiguous(),
+        part_acc, part_m, part_l, sel_slab, sel_hist, attn_out,
+        B, int(skv_cap), H, Hidx, topk, nsplit, float(sm_scale),
+        launch_with_select, launch_attn_on,   # full=(1,1) attn_only=(0,1) scan_only=(1,0)
+        kv_stride, pt_stride, page_bytes, int(skv_cap), int(nsplit_attn),
+        kv_fp8, kv_rows, sel_on, sel_scratch, next_idx_buf, int(_HIDE_APPROX_M),
+    )
+
+    logits = sel_slab.view(B, int(skv_cap))
+    out_view = attn_out[:, :, :H_real, :] if H != H_real else attn_out
+    if mode == "attn_only":
+        # only the fused attention ran (no scan / no select): return the output.
+        return out_view
+    if mode == "scan_only":
+        # only the scan ran: the [B, skv_cap] full-prefix logit slab for the
+        # caller's deferred top-k (attn_out is untouched scratch, do not use).
+        return logits
+    if sel_mode == "prod":
+        return out_view, logits
+    if sel_mode in _KERNEL_SELECT_MODES:
+        # next_idx is a VIEW of persistent scratch (rewritten by the next launch)
+        assert index_topk == topk, "in-kernel select emits exactly topk indices"
+        if return_logits:
+            return out_view, next_idx_buf, logits
+        return out_view, next_idx_buf
+
+    # --- torch top-k over the full-prefix indexer logits (gate only) ---------
+    assert out_index_pool is not None, "select='torch' needs out_index_pool"
+    k = min(int(index_topk), int(skv_cap))
+    top_v, top_pos = torch.topk(logits, k, dim=-1)
+    next_idx = torch.gather(out_index_pool.long()[:, : int(skv_cap)], 1, top_pos)
+    # -inf = an unwritten (beyond-length) position: never a valid selection
+    next_idx = torch.where(torch.isfinite(top_v), next_idx, torch.full_like(next_idx, -1))
+    if k < index_topk:
+        pad = torch.full((B, index_topk - k), -1, dtype=next_idx.dtype, device=device)
+        next_idx = torch.cat([next_idx, pad], dim=1)
+    if return_logits:
+        return out_view, next_idx, logits.clone()
+    return out_view, next_idx
diff --git a/python/sglang/srt/layers/attention/dsa_backend.py b/python/sglang/srt/layers/attention/dsa_backend.py
--- a/python/sglang/srt/layers/attention/dsa_backend.py
+++ b/python/sglang/srt/layers/attention/dsa_backend.py
@@ -18,6 +18,420 @@
 from sglang.srt.runtime_context import get_parallel
 
 logger = logging.getLogger(__name__)
+
+# HH cascade tap registry: layer_id -> (q_nope, q_rope, kv_cache, sm_scale)
+# stashed by forward_decode for consumption by the next layer's index re-rank
+# (see forward_mla._cascade_rerank_indices). Overwritten every decode forward.
+_hh_tap_registry: dict = {}
+
+
+def hh_get_tap(layer_id: int):
+    return _hh_tap_registry.get(layer_id)
+
+
+# E4d fused-cascade registry: layer_id -> next_idx tensor. Populated by
+# forward_decode when a shared layer runs the FUSED tap-cascade kernel (attention
+# + next-index re-derivation in one launch); the NEXT shared layer's
+# _transform_reuse_indices reads layer_id-1 to obtain its incumbent set (instead
+# of re-scoring with a side kernel). Overwritten every decode forward.
+_hh_fused_next_idx: dict = {}
+# Persistent per-layer buffers backing the registry. CUDA-graph safety: the OLD
+# code reassigned _hh_fused_next_idx[layer_id] to a fresh transient (pool) tensor
+# every forward, freeing the previous one. Under multi-bs graph capture the shared
+# graph mempool then reuses that freed region for a LATER graph's live buffer, so
+# replaying an EARLIER graph reads/writes aliased memory -> garbage next_idx ->
+# the sparse-attention kernel gathers out-of-bounds -> illegal access (observed:
+# bs=2 replay dies only after bs=4/8 are also captured). Fix: allocate ONE buffer
+# per layer (the first write; retained forever so its address is never reused) and
+# copy_ into it each forward. The stored view aliases that stable buffer.
+_hh_fused_next_idx_buf: dict = {}
+# Capacity for the persistent buffers' batch dim; set (>=max cuda-graph bs) by
+# init_cuda_graph_state so the first in-capture allocation is already large enough
+# and never needs to grow (a realloc mid-capture would reintroduce the hazard).
+_hh_next_idx_cap: int = 0
+
+
+def hh_set_next_idx_cap(cap: int) -> None:
+    global _hh_next_idx_cap
+    _hh_next_idx_cap = max(_hh_next_idx_cap, int(cap))
+
+
+# Bumped on every change to the fused-HIDE serving path; echoed in the engagement
+# line so a cell's server log records which wrapper version it ran.
+_HH_HIDE_WRAPPER_VERSION = "2026-09-03c-v12-fp8pool-wgmma-sidestream-prep+select"
+
+
+def hh_get_fused_next_idx(layer_id: int):
+    return _hh_fused_next_idx.get(layer_id)
+
+
+def hh_set_fused_next_idx(layer_id: int, next_idx) -> None:
+    b = next_idx.shape[0]
+    buf = _hh_fused_next_idx_buf.get(layer_id)
+    if (
+        buf is None
+        or buf.shape[0] < b
+        or tuple(buf.shape[1:]) != tuple(next_idx.shape[1:])
+        or buf.dtype != next_idx.dtype
+        or buf.device != next_idx.device
+    ):
+        # First write for this layer (or a shape/dtype change): allocate a persistent
+        # buffer sized to the graph capacity and RETAIN it. Sizing to the cap means
+        # this never reallocates during capture/replay (b <= cap there).
+        cap = max(b, _hh_next_idx_cap)
+        buf = next_idx.new_empty((cap,) + tuple(next_idx.shape[1:]))
+        _hh_fused_next_idx_buf[layer_id] = buf
+    buf[:b].copy_(next_idx)
+    _hh_fused_next_idx[layer_id] = buf[:b]
+
+
+# Adaptive refresh: last layer that ran its own indexer (not reuse).
+# Read by should_run_indexer to enforce max-span constraints during decode.
+# Plain int — used in Python control flow only, so CUDA-graph-safe (the
+# adaptive layer set is static for a fixed max_span config).
+_hh_last_indexer_layer: int = -1
+
+
+def hh_get_last_indexer_layer() -> int:
+    return _hh_last_indexer_layer
+
+
+def hh_set_last_indexer_layer(layer_id: int) -> None:
+    global _hh_last_indexer_layer
+    _hh_last_indexer_layer = layer_id
+
+
+# E5 wide-pool registry: layer_id -> pool_idx tensor (trailing dim = pool_topk).
+# Populated by the REFRESH layer's indexer decode seed (dsa_indexer._get_topk_paged,
+# one extra topk_transform at width pool_topk) and by each reuse layer's wide
+# re-rank emit (forward_mla._cascade_rerank_indices); the NEXT reuse layer reads
+# layer_id-1 as its WIDE incumbent (width pool_topk), distinct from the width-
+# index_topk attended set that threads to the attention kernel. Same anti-alias
+# design as the fused registry: ONE retained buffer per layer (allocated on the
+# first write and retained forever so its address is never reused by the shared
+# graph mempool), copy_ into it each forward. The buffer's trailing dim is
+# pool_topk (fixed by the first write's width). Only touched when the wide-pool
+# knob is active (index_pool_topk > index_topk); otherwise never written/read.
+_hh_index_pool: dict = {}
+_hh_index_pool_buf: dict = {}
+
+
+def hh_set_index_pool(layer_id: int, idx) -> None:
+    b = idx.shape[0]
+    buf = _hh_index_pool_buf.get(layer_id)
+    if (
+        buf is None
+        or buf.shape[0] < b
+        or tuple(buf.shape[1:]) != tuple(idx.shape[1:])
+        or buf.dtype != idx.dtype
+        or buf.device != idx.device
+    ):
+        # First write for this layer (or a shape/dtype change): allocate a
+        # persistent buffer sized to the graph capacity (reusing the fused
+        # registry's cap, seeded by init_cuda_graph_state) and RETAIN it so it
+        # never reallocates during capture/replay (b <= cap there).
+        cap = max(b, _hh_next_idx_cap)
+        buf = idx.new_empty((cap,) + tuple(idx.shape[1:]))
+        _hh_index_pool_buf[layer_id] = buf
+    buf[:b].copy_(idx)
+    _hh_index_pool[layer_id] = buf[:b]
+
+
+def hh_get_index_pool(layer_id: int, bsz: int):
+    # bsz-mismatch-is-a-miss: the registry is GLOBAL across CUDA-graph captures of
+    # different batch sizes; a bsz-mismatched entry is STALE from a prior-bsz
+    # capture, not a valid incumbent -> read it as a miss and let the caller
+    # bootstrap at the current bsz (mirrors the fused-path bsz guard in
+    # _fused_reuse_transform, forward_mla.py:534).
+    v = _hh_index_pool.get(layer_id)
+    if v is None or v.shape[0] != bsz:
+        return None
+    return v
+
+
+import os as _hh_os
+_HH_LAGDEF_FUSED_ATTN = _hh_os.environ.get("HH_LAGDEF_FUSED_ATTN") == "1"
+import time as _hh_time
+# Env-gated CUDA-synchronized region timing for the tap (EAGER only; CUPTI/torch
+# profiler is broken in the enroot container). HH_TAP_TIMING=1 accumulates GPU
+# wall-time per region and logs periodically so we can split the tap overhead
+# into kernel-epilogue (kernel_tap vs kernel_base delta) vs all-reduce vs admission.
+_HH_TAP_TIMING = _hh_os.environ.get("HH_TAP_TIMING") == "1"
+_HH_TAP_T: dict = {}
+def _hh_tick(name: str, t0: float) -> None:
+    torch.cuda.synchronize()
+    r = _HH_TAP_T.setdefault(name, [0.0, 0])
+    r[0] += _hh_time.perf_counter() - t0
+    r[1] += 1
+    if name == "admission" and r[1] % 300 == 0:
+        import logging as _lg
+        _lg.getLogger("hh_tap_timing").warning(
+            "HH_TAP_TIMING(ms_total/calls, avg_us): %s",
+            {k: (round(v[0]*1e3, 1), v[1], round(v[0]/max(v[1],1)*1e6, 1))
+             for k, v in _HH_TAP_T.items()},
+        )
+
+# --- HARDENING: fused-path engagement accounting (anti-false-claim) -----------
+# Each fused decode path increments its counter when the kernel ACTUALLY runs and
+# its fallback counter when it silently reverts. A serving measurement is VOID
+# unless the intended path's engaged-count is > 0 and dominates its fallbacks --
+# enforced by validate_serving_run.py. The first event of each kind and periodic
+# totals are logged so the counts are visible in the server log for the gate.
+_HH_ENGAGE: dict = {
+    "hide_fused": 0,
+    "cascade_fused": 0,
+    "cascade_shape_fallback": 0,
+    "adaptive_refresh": 0,
+    "pool_rerank": 0,
+    # reuse_fused serving composition (index_reuse_lag_refresh): counts
+    # refresh-layer one-layer-lag handoffs (attend incumbent, fresh carry-out).
+    "lag_refresh": 0,
+    # reuse_fused slice 2 (index_reuse_lag_refresh_deferred): counts handoffs
+    # whose fresh-set indexer was DEFERRED onto the dedicated side stream
+    # (joined at the next layer's prepare entry). A slice-2 arm must show this
+    # marker > 0, else it silently measured the serial slice-1 path.
+    "lag_refresh_deferred": 0,
+    # lag depth k (index_reuse_lag_depth >= 2): counts refresh layers that
+    # JOINED a deferred indexer k refresh layers old (the queue-full steady
+    # state). Key is "lag_depth_<k>" (k=3 lands under lag_depth_3, created
+    # on first increment); the gate for a k=2 arm is first 'lag_depth_2'.
+    "lag_depth_2": 0,
+}
+_HH_ENGAGE_SEEN: set = set()
+
+
+def _hh_engage_inc(key: str) -> None:
+    n = _HH_ENGAGE.get(key, 0) + 1
+    _HH_ENGAGE[key] = n
+    if key not in _HH_ENGAGE_SEEN:
+        _HH_ENGAGE_SEEN.add(key)
+        logger.warning("[ENGAGE] first '%s' event -> fused path is live", key)
+        # COMBINED-mode witness (prereg_quality_wave.md cell Q2): emitted
+        # exactly once, when BOTH the refresh-layer lag handoff AND a
+        # consumer-layer tap re-rank (kernel or triton) have fired in this
+        # process. The anti-false-claim gate keys the combined arm on this
+        # marker so neither half can silently degrade to the other mode.
+        # (Checked only on first events: the combo becomes true exactly when
+        # the LATER of the two first-fires happens, always in this branch.)
+        if (
+            "lag_refresh_rerank" not in _HH_ENGAGE_SEEN
+            and _HH_ENGAGE.get("lag_refresh", 0) > 0
+            and (
+                _HH_ENGAGE.get("cascade_fused", 0) > 0
+                or _HH_ENGAGE.get("triton_rerank", 0) > 0
+            )
+        ):
+            _HH_ENGAGE_SEEN.add("lag_refresh_rerank")
+            logger.warning(
+                "[ENGAGE] first 'lag_refresh_rerank' event -> combined "
+                "lag-refresh + consumer tap re-rank is live"
+            )
+    if n % 2000 == 0:
+        logger.warning("[ENGAGE] counts=%s", _HH_ENGAGE)
+
+
+def hh_engagement_report() -> dict:
+    logger.warning("[ENGAGE-REPORT] %s", dict(_HH_ENGAGE))
+    return dict(_HH_ENGAGE)
+
