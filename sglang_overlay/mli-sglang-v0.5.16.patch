+def _install_projection(linear: nn.Module, weight: torch.Tensor) -> nn.Module:
+    """Install distilled weight into a linear, returning the (possibly replaced) module."""
+    if tuple(linear.weight.shape) != tuple(weight.shape):
+        raise ValueError(
+            f"distilled weight shape {tuple(weight.shape)} != target {tuple(linear.weight.shape)}"
+        )
+    target_dtype = linear.weight.dtype
+    if target_dtype == torch.float8_e4m3fn:
+        return _BF16Linear(weight.to(linear.weight.device))
+    linear.weight = nn.Parameter(
+        weight.to(target_dtype).to(linear.weight.device), requires_grad=False
+    )
+    for scale_attr in ("scale", "weight_scale"):
+        if getattr(linear, scale_attr, None) is not None:
+            linear.register_parameter(scale_attr, None)
+    return linear
+
+
