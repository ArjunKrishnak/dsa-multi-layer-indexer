+def _hh_wide_topk_transform_paged(
+    logits: torch.Tensor,
+    lengths: torch.Tensor,
+    topk: int,
+    attn_metadata,
+) -> torch.Tensor:
+    """Arbitrary-width (topk > 2048) torch analogue of ``_topk_transform_v2_paged``.
+
+    All fused/sgl-kernel topk-transforms are hardcoded to topk <= 2048, but the
+    wide-pool two-stage seed (``index_pool_topk``) needs the top-``topk`` PHYSICAL
+    KV slots so the reuse-layer cascade can re-rank a pool wider than the attended
+    2048. This runs on refresh layers only (1-in-``index_topk_freq``), so a torch
+    top-k is acceptable; a fused wide kernel is a later latency optimization.
+
+    Replicates the v2 mapping EXACTLY (docstring of ``_topk_transform_v2_paged``):
+    per row, select the top-k of ``logits[row, :lengths[row]]``, then map each
+    selected logical position ``p`` to
+    ``real_page_table[row, p // page_size] * page_size + (p % page_size)``, with
+    ``-1`` padding for rows whose valid length is below ``topk``. Static output
+    shape ``(num_rows, topk)`` int32 -> graph-capturable.
+    """
+    from sglang.srt.model_executor.forward_context import get_token_to_kv_pool
+
+    num_rows, width = logits.shape
+    device = logits.device
+    page_table = attn_metadata.real_page_table  # (num_rows, num_pages) int32
+    page_size = get_token_to_kv_pool().page_size
+
+    # Bound each row to its valid length so top-k never selects an out-of-range
+    # position (lengths read as the true KV length per row; the v2 kernel selects
+    # only from ``logits[row, :lengths[row]]``).
+    positions = torch.arange(width, device=device).unsqueeze(0)  # (1, width)
+    valid_pos = positions < lengths.to(device).view(-1, 1)  # (num_rows, width)
+    masked = logits.masked_fill(~valid_pos, float("-inf"))
+
+    k = min(topk, width)
+    top = torch.topk(masked, k=k, dim=1)
+    pos = top.indices  # (num_rows, k) logical positions
+    picked_valid = torch.isfinite(top.values)  # a real (non -inf) key was picked
+
+    page_idx = (pos // page_size).to(torch.int64)
+    in_page = pos % page_size
+    base_slot = torch.gather(page_table, 1, page_idx).to(torch.int64)
+    phys = base_slot * page_size + in_page
+    phys = phys.masked_fill(~picked_valid, -1).to(torch.int32)
+
+    if k < topk:
+        # Only when the context is shorter than the pool (short prompts); pad to the
+        # static ``topk`` width with -1 so the registry buffer width is invariant.
+        pad = phys.new_full((num_rows, topk - k), -1)
+        phys = torch.cat([phys, pad], dim=1)
+    return phys
+
