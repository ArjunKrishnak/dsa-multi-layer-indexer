+"""Inject distilled indexer weights into a DSA model for serving.
+
+Ported from the research harness (lagged_indexer_dsa.distill.inject).
+Loads a .pt payload of distilled score-projection heads and replaces
+the corresponding shipped Indexer parameters in-place.  Backbone stays
+frozen; arithmetic and kernel path are unchanged.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+logger = logging.getLogger(__name__)
+
+
+def load_distilled_payload(path: str) -> dict:
+    payload = torch.load(path, map_location="cpu", weights_only=True)
+    if "layers" not in payload:
+        raise ValueError(f"{path} is not a distilled-indexer payload (missing 'layers')")
+    return payload
+
+
+class _BF16Linear(nn.Module):
+    """Drop-in for a quantized ReplicatedLinear: BF16 matmul, returns (out, None)."""
