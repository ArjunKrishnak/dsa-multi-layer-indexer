+    def _forward_fused_cascade(self, q_all, q_nope, kv_cache, layer, fused_ctx):
+        """E4d: one fused launch computes this shared layer's sparse-MLA
+        attention (over its incumbent slots) AND re-derives the next shared
+        layer's index set from the same QK^T. Returns attention in flashmla_kv's
+        [B, 1, H, 512] format, or None to fall back to the normal path.
+
+        fused_ctx = (incumbent_slots[B,topk], window_slots[B,W] or None,
+        out_index_pool[B,topk+W] or None, tapw[H] or None, all_reduce_fn or None).
+        The slot tensors are page_size=1 KV slots (for the gather/attention); the
+        out_index_pool is the caller's NATIVE index space (positions) aligned with
+        [incumbent ++ window], so next_idx is threaded back in the pipeline's
+        space. Assembled model-side by _fused_reuse_transform (reuses the exact
+        pool the triton cascade builds: incumbent + recency-window + sink).
+        """
+        try:
+            from sglang.srt.layers.attention.dsa.hh_fused_decode import (
+                _hh_fused_cascade_decode,
+            )
